# Astro frontend env vars (build-time, exposed to client when prefixed PUBLIC_).
# Copy to .env (gitignored) and fill with real values.

# Turnstile site key — used by the AI Audit Tool form to render the anti-bot widget.
# Public-safe (it's visible in the rendered HTML). The matching secret lives in .dev.vars.
# Dev test key (always-pass) for local: 1x00000000000000000000AA
# Get a real one at https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
