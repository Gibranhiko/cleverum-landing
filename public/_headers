# Security & cache headers para Cloudflare Pages
# Doc: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Hashed assets de Astro — cache largo e immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes estáticas
/og/*
  Cache-Control: public, max-age=31536000, immutable

/favicons/*
  Cache-Control: public, max-age=31536000, immutable

# Manifest
/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

# LLM-readable site context
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Structured site info (consumable by AI agents)
/api/info.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
