---
import { site } from '~/content/site';
import WhatsAppButton from '~/components/ui/WhatsAppButton.astro';

const { contactCta } = site;
---

<section id="contacto" class="cta" aria-labelledby="cta-heading">
  <div class="cta-inner container-narrow">
    <h2 id="cta-heading" class="cta-title font-display">
      {contactCta.heading.split('?')[0]}<span class="gradient-text-go">?</span>
    </h2>

    <p class="cta-sub">{contactCta.subheading}</p>

    <div class="cta-actions">
      <WhatsAppButton label={contactCta.ctaLabel} variant="secondary" size="lg" />
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding-block: clamp(6rem, 12vw, 10rem);
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    text-align: center;
    align-items: center;
  }

  .cta-title {
    font-size: var(--fs-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 600;
    margin: 0;
    text-wrap: balance;
    max-width: 18ch;
  }

  .cta-sub {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--color-text-2);
    max-width: 52ch;
    margin: 0 auto;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  @media (min-width: 600px) {
    .cta-actions {
      flex-direction: row;
      gap: 1.5rem;
    }
  }
</style>
