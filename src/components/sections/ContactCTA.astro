---
import { site } from '~/content/site';

const { finalCta } = site;
---

<section id="contacto" class="cta section-pad" aria-labelledby="cta-heading">
  <div class="cta-inner container-narrow">
    <h2 id="cta-heading" class="cta-title font-display">
      {finalCta.heading.split('?')[0]}<span class="gradient-text-go">?</span>
    </h2>

    <p class="cta-sub">{finalCta.sub}</p>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
    text-align: center;
    align-items: center;
  }

  .cta-title {
    font-size: var(--fs-display, clamp(2.25rem, 6vw, 4.5rem));
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
    margin: 0;
    text-wrap: balance;
    max-width: 18ch;
  }

  .cta-sub {
    font-size: var(--fs-lead, 1.1rem);
    line-height: 1.55;
    color: var(--color-text-2);
    max-width: 56ch;
    margin: 0 auto;
  }
</style>
