---
import { site } from '~/content/site';
import AiAuditTool from '~/components/react/AiAuditTool';

const { audit } = site;
---

<section id="diagnostico" class="diag section-pad" aria-labelledby="diag-heading">
  <div class="container-narrow diag-inner">
    <header class="diag-header">
      <div class="diag-eyebrow">
        <span class="diag-eyebrow-dot" aria-hidden="true"></span>
        {audit.eyebrow}
      </div>
      <h2 id="diag-heading" class="diag-heading font-display">{audit.heading}</h2>
    </header>

    <AiAuditTool client:visible />
  </div>
</section>

<style>
  .diag {
    scroll-margin-top: 5rem;
    position: relative;
  }

  .diag-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .diag-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .diag-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-2);
    font-weight: 500;
  }

  .diag-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-iris);
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-brand-iris) 60%, transparent);
    animation: diag-pulse 1.6s ease-in-out infinite;
  }

  @keyframes diag-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .diag-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
    text-wrap: balance;
    max-width: 18ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .diag-eyebrow-dot {
      animation: none;
    }
  }
</style>
