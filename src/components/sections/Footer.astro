---
import { site } from '~/content/site';

const year = new Date().getFullYear();
const { socials, footer, brand, contact, finalCta } = site;
---

<footer id="contacto" class="footer" role="contentinfo">
  <div class="footer-inner container-narrow">
    <!-- Question + arrow up linking to diagnóstico -->
    <a
      href="#diagnostico"
      class="footer-question"
      aria-label={`${finalCta.heading} Ir al diagnóstico`}
    >
      <span class="footer-question-text font-display">
        <span class="gradient-text-go">{finalCta.heading}</span>
      </span>
      <span class="footer-question-arrow" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 19V5"></path>
          <path d="m5 12 7-7 7 7"></path>
        </svg>
      </span>
    </a>

    <p class="footer-invitation">El diagnóstico gratis está arriba ↑ — o escríbenos directo:</p>

    <ul class="footer-contact" aria-label="Contacto directo">
      <li>
        <a href={`tel:${contact.phoneTel}`}>{contact.phoneDisplay}</a>
      </li>
      <li>
        <a href={`mailto:${contact.email}`} aria-label={`Mandar mail a ${brand.name}`}>
          Manda un mail
        </a>
      </li>
    </ul>

    <ul class="footer-socials" aria-label="Redes sociales">
      <li>
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={socials.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (Twitter)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a href={socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.51 11.51 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a href={`mailto:${socials.email}`} aria-label="Email">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
        </a>
      </li>
    </ul>

    <hr class="footer-divider" />

    <div class="footer-bottom">
      <span class="footer-copy">© {year} {brand.name} · {footer.note}</span>
      <em class="footer-manifesto-tag">{footer.manifesto}</em>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(4rem, 8vw, 7rem);
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-base) 75%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    scroll-margin-top: 5rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
    text-align: center;
  }

  /* --- Question + arrow --- */
  .footer-question {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    text-decoration: none;
    color: var(--color-text-1);
    transition: transform 0.3s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-question-text {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    text-wrap: balance;
    max-width: 18ch;
  }

  .footer-question-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-2);
    background: color-mix(in srgb, var(--color-bg-elev) 60%, transparent);
    backdrop-filter: blur(8px);
    transition:
      transform 0.3s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .footer-question:hover .footer-question-arrow {
    transform: translateY(-4px);
    color: var(--color-text-1);
    border-color: color-mix(in srgb, var(--color-brand-iris) 60%, var(--color-border));
    background: color-mix(in srgb, var(--color-brand-iris) 15%, transparent);
  }

  .footer-question:focus-visible {
    outline: 2px solid var(--color-brand-iris);
    outline-offset: 6px;
    border-radius: 12px;
  }

  /* --- Invitation --- */
  .footer-invitation {
    margin: 0;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    color: var(--color-text-2);
    line-height: 1.5;
    max-width: 48ch;
  }

  /* --- Contact text links (phone + email) --- */
  .footer-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-contact a {
    display: inline-block;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    font-weight: 500;
    color: var(--color-text-1);
    letter-spacing: -0.005em;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .footer-contact a:hover {
    color: var(--color-brand-iris);
    background: color-mix(in srgb, var(--color-brand-iris) 8%, transparent);
  }

  /* --- Social icons --- */
  .footer-socials {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-socials a {
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-2);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-socials a:hover {
    color: var(--color-text-1);
    border-color: color-mix(in srgb, var(--color-brand-iris) 50%, var(--color-border));
    background-color: color-mix(in srgb, var(--color-brand-iris) 10%, transparent);
    transform: translateY(-1px);
  }

  /* --- Divider + bottom --- */
  .footer-divider {
    width: 100%;
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: 0;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    font-size: 0.85rem;
    color: var(--color-text-3);
    text-align: center;
    align-items: center;
  }

  .footer-copy {
    letter-spacing: 0.01em;
  }

  .footer-manifesto-tag {
    font-style: italic;
    color: var(--color-text-2);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
  }

  @media (min-width: 720px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-question,
    .footer-question:hover .footer-question-arrow,
    .footer-socials a:hover {
      transform: none;
    }
  }
</style>
