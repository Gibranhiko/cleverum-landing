---
import { site, accentVar } from '~/content/site';

const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="footer-inner container-narrow">
    <div class="footer-brands">
      {
        site.brands.map((b) => (
          <div class="footer-brand" style={`--accent: ${accentVar[b.accent]};`}>
            <div class="footer-brand-logo" aria-label={`Logo de ${b.name} — placeholder`}>
              {b.logoSrc ? (
                <img src={b.logoSrc} alt={`${b.name} logo`} width="40" height="40" />
              ) : (
                <span class="footer-brand-logo-initial font-display">{b.name.charAt(0)}</span>
              )}
            </div>
            <div class="footer-brand-text">
              <span class="footer-brand-name font-display">{b.name}</span>
              <span class="footer-brand-tagline">{b.tagline}</span>
            </div>
          </div>
        ))
      }
    </div>

    <hr class="footer-divider" />

    <div class="footer-bottom">
      <span class="footer-copy">
        © {year} {site.meta.title.split(' — ')[0]}. {site.footer.rights}
      </span>
      <span class="footer-note">{site.footer.note}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-base) 75%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .footer-brands {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 720px) {
    .footer-brands {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  /* Logo placeholder */
  .footer-brand-logo {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 10%, var(--color-bg-soft));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--color-border));
    color: var(--accent);
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }

  .footer-brand-logo:not(:has(img))::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 8px;
    border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent);
    pointer-events: none;
  }

  .footer-brand-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .footer-brand-logo-initial {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .footer-brand-name {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-1);
    line-height: 1.1;
  }

  .footer-brand-tagline {
    font-size: var(--fs-small);
    color: var(--color-text-2);
    line-height: 1.35;
  }

  .footer-divider {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: 0;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: flex-start;
    font-size: var(--fs-small);
    color: var(--color-text-3);
  }

  @media (min-width: 600px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
