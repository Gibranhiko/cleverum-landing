---
import { site } from '~/content/site';
import AiAuditTool from '~/components/react/AiAuditTool';

const { hero } = site;

interface Word {
  text: string;
  accent: boolean;
  index: number;
}

function parsePhrase(text: string): Word[] {
  const parts = text.split(/(\*[^*]+\*)/g).filter(Boolean);
  let i = 0;
  const out: Word[] = [];
  for (const part of parts) {
    const isAccent = part.startsWith('*') && part.endsWith('*');
    const clean = isAccent ? part.slice(1, -1) : part;
    for (const word of clean.split(/\s+/).filter(Boolean)) {
      out.push({ text: word, accent: isAccent, index: i++ });
    }
  }
  return out;
}

const phrases = hero.rotatingTitles.map((t) => ({
  text: t.replace(/\*/g, ''),
  words: parsePhrase(t),
}));

const PHRASE_COUNT = phrases.length;
const SLOT_SECONDS = 6;
const CYCLE_SECONDS = PHRASE_COUNT * SLOT_SECONDS;
const WORD_STAGGER_MS = 55;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-inner container-narrow">
    <div class="hero-titles">
      <h1 id="hero-title" class="sr-only">{phrases[0]?.text ?? 'Cleverum'}</h1>

      <div
        class="hero-rotator"
        aria-hidden="true"
        style={`--cycle: ${CYCLE_SECONDS}s; --slot: ${SLOT_SECONDS}s; --stagger: ${WORD_STAGGER_MS}ms;`}
      >
        {
          phrases.map((p, phaseIdx) => (
            <p class="hero-phrase font-display" style={`--phase: ${phaseIdx};`}>
              {p.words.map((w) => (
                <span
                  class={`hero-word ${w.accent ? 'is-accent' : ''}`}
                  style={`--i: ${w.index};`}
                >
                  {w.accent ? <span class="gradient-text">{w.text}</span> : w.text}
                </span>
              ))}
            </p>
          ))
        }
      </div>
    </div>

    <div class="hero-audit">
      <AiAuditTool client:visible />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    padding-block: clamp(5rem, 9vw, 8rem);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
    width: 100%;
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  .hero-titles {
    min-width: 0;
  }

  .hero-audit {
    min-width: 0;
    width: 100%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* ---- Rotator container ---- */
  .hero-rotator {
    position: relative;
    width: 100%;
    min-height: clamp(8rem, 16vw, 13rem);
    perspective: 1400px;
    perspective-origin: 50% 30%;
  }

  .hero-phrase {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: var(--color-text-1);
    text-wrap: balance;
    max-width: 18ch;
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.18em;
    opacity: 0;
    transform-style: preserve-3d;
    transform: translateY(75%) translateZ(-120px) rotateX(45deg);
    filter: blur(22px);
    animation: word-cycle var(--cycle) linear infinite;
    animation-delay: calc(var(--phase) * var(--slot) + var(--i) * var(--stagger));
    will-change: transform, opacity, filter;
  }

  .hero-word.is-accent {
    position: relative;
  }

  @keyframes word-cycle {
    0% {
      opacity: 0;
      transform: translateY(75%) translateZ(-120px) rotateX(45deg);
      filter: blur(22px);
    }
    1.5% {
      opacity: 0.4;
      transform: translateY(40%) translateZ(-60px) rotateX(22deg);
      filter: blur(12px);
    }
    3.5% {
      opacity: 1;
      transform: translateY(0) translateZ(0) rotateX(0);
      filter: blur(0);
    }
    16% {
      opacity: 1;
      transform: translateY(0) translateZ(0) rotateX(0);
      filter: blur(0);
    }
    18% {
      opacity: 0.5;
      transform: translateY(-22%) translateZ(40px) rotateX(-12deg);
      filter: blur(10px);
    }
    19.5% {
      opacity: 0;
      transform: translateY(-45%) translateZ(80px) rotateX(-22deg);
      filter: blur(20px);
    }
    100% {
      opacity: 0;
      transform: translateY(-45%) translateZ(80px) rotateX(-22deg);
      filter: blur(20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-phrase:not(:first-child) {
      display: none;
    }
    .hero-phrase {
      position: static;
    }
    .hero-rotator {
      min-height: auto;
    }
  }
</style>
