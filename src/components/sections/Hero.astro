---
import { site } from '~/content/site';
import WhatsAppButton from '~/components/ui/WhatsAppButton.astro';
import AiAuditTool from '~/components/react/AiAuditTool';

const { hero, contact } = site;

interface Word {
  text: string;
  accent: boolean;
  index: number;
}

function parsePhrase(text: string): Word[] {
  const parts = text.split(/(\*[^*]+\*)/g).filter(Boolean);
  let i = 0;
  const out: Word[] = [];
  for (const part of parts) {
    const isAccent = part.startsWith('*') && part.endsWith('*');
    const clean = isAccent ? part.slice(1, -1) : part;
    for (const word of clean.split(/\s+/).filter(Boolean)) {
      out.push({ text: word, accent: isAccent, index: i++ });
    }
  }
  return out;
}

const phrases = hero.rotatingTitles.map((t) => ({
  text: t.replace(/\*/g, ''),
  words: parsePhrase(t),
}));

const PHRASE_COUNT = phrases.length;
const SLOT_SECONDS = 6;
const CYCLE_SECONDS = PHRASE_COUNT * SLOT_SECONDS;
const WORD_STAGGER_MS = 55;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-inner container-narrow">
    <h1 id="hero-title" class="sr-only">{phrases[0]?.text ?? 'Cleverum'}</h1>

    <div
      class="hero-rotator"
      aria-hidden="true"
      style={`--cycle: ${CYCLE_SECONDS}s; --slot: ${SLOT_SECONDS}s; --stagger: ${WORD_STAGGER_MS}ms;`}
    >
      {
        phrases.map((p, phaseIdx) => (
          <p class="hero-phrase font-display" style={`--phase: ${phaseIdx};`}>
            {p.words.map((w) => (
              <span
                class={`hero-word ${w.accent ? 'is-accent' : ''}`}
                style={`--i: ${w.index};`}
              >
                {w.accent ? <span class="gradient-text">{w.text}</span> : w.text}
              </span>
            ))}
          </p>
        ))
      }
    </div>

    <AiAuditTool client:visible />

    <div class="hero-cta">
      <WhatsAppButton label={hero.ctaPrimary} variant="secondary" size="lg" />
      <a
        class="cta-secondary"
        href={contact.calendly}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>{hero.ctaSecondary}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    padding-block: clamp(6rem, 10vw, 9rem);
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: flex-start;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* ---- Rotator container ---- */
  .hero-rotator {
    position: relative;
    width: 100%;
    min-height: clamp(9rem, 17vw, 14rem);
    perspective: 1400px;
    perspective-origin: 50% 30%;
  }

  .hero-phrase {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: var(--color-text-1);
    text-wrap: balance;
    max-width: 22ch;
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.18em;
    opacity: 0;
    transform-style: preserve-3d;
    transform: translateY(75%) translateZ(-120px) rotateX(45deg);
    filter: blur(22px);
    animation: word-cycle var(--cycle) linear infinite;
    animation-delay: calc(var(--phase) * var(--slot) + var(--i) * var(--stagger));
    will-change: transform, opacity, filter;
  }

  .hero-word.is-accent {
    position: relative;
  }

  @keyframes word-cycle {
    0% {
      opacity: 0;
      transform: translateY(75%) translateZ(-120px) rotateX(45deg);
      filter: blur(22px);
    }
    1.5% {
      opacity: 0.4;
      transform: translateY(40%) translateZ(-60px) rotateX(22deg);
      filter: blur(12px);
    }
    3.5% {
      opacity: 1;
      transform: translateY(0) translateZ(0) rotateX(0);
      filter: blur(0);
    }
    16% {
      opacity: 1;
      transform: translateY(0) translateZ(0) rotateX(0);
      filter: blur(0);
    }
    18% {
      opacity: 0.5;
      transform: translateY(-22%) translateZ(40px) rotateX(-12deg);
      filter: blur(10px);
    }
    19.5% {
      opacity: 0;
      transform: translateY(-45%) translateZ(80px) rotateX(-22deg);
      filter: blur(20px);
    }
    100% {
      opacity: 0;
      transform: translateY(-45%) translateZ(80px) rotateX(-22deg);
      filter: blur(20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-phrase:not(:first-child) {
      display: none;
    }
    .hero-phrase {
      position: static;
    }
    .hero-rotator {
      min-height: auto;
    }
  }

  /* ---- CTAs row ---- */
  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    opacity: 0;
    transform: translateY(20px);
    animation: cta-rise 1s var(--ease-out-expo) 0.6s forwards;
  }

  @media (min-width: 600px) {
    .hero-cta {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
  }

  @keyframes cta-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-2);
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .cta-secondary:hover {
    color: var(--color-text-1);
    gap: 0.75rem;
  }

  .cta-secondary svg {
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  .cta-secondary:hover svg {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
