---
import { site } from '~/content/site';

const { hero } = site;

interface Word {
  text: string;
  accent: boolean;
  index: number;
}

function parsePhrase(text: string): Word[] {
  const parts = text.split(/(\*[^*]+\*)/g).filter(Boolean);
  let i = 0;
  const out: Word[] = [];
  for (const part of parts) {
    const isAccent = part.startsWith('*') && part.endsWith('*');
    const clean = isAccent ? part.slice(1, -1) : part;
    for (const word of clean.split(/\s+/).filter(Boolean)) {
      out.push({ text: word, accent: isAccent, index: i++ });
    }
  }
  return out;
}

const phrases = hero.rotatingTitles.map((t) => ({
  text: t.replace(/\*/g, ''),
  words: parsePhrase(t),
}));

const PHRASE_COUNT = phrases.length;
const SLOT_SECONDS = 6;
const CYCLE_SECONDS = PHRASE_COUNT * SLOT_SECONDS;
const WORD_STAGGER_MS = 55;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <h1 id="hero-title" class="sr-only">{phrases[0]?.text ?? 'Cleverum'}</h1>

    <div
      class="hero-rotator"
      aria-hidden="true"
      style={`--cycle: ${CYCLE_SECONDS}s; --slot: ${SLOT_SECONDS}s; --stagger: ${WORD_STAGGER_MS}ms;`}
    >
      {
        phrases.map((p, phaseIdx) => (
          <p class="hero-phrase font-display" style={`--phase: ${phaseIdx};`}>
            {p.words.map((w) => (
              <span class={`hero-word ${w.accent ? 'is-accent' : ''}`} style={`--i: ${w.index};`}>
                {w.accent ? <span class="gradient-text">{w.text}</span> : w.text}
              </span>
            ))}
          </p>
        ))
      }
    </div>

    <p class="hero-subline">{hero.subline}</p>

    <div class="hero-cta-row">
      <a href="#diagnostico" class="hero-cta">
        <span>{hero.ctaLabel}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>

  <a href="#diagnostico" class="hero-scroll-hint" aria-label="Ir al diagnóstico">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(5rem, 9vw, 8rem) clamp(1.25rem, 4vw, 3rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 90% at center,
      color-mix(in srgb, var(--color-bg-base) 82%, transparent),
      transparent 90%
    );
    z-index: -1;
    pointer-events: none;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(1rem, 1.8vw, 1.5rem);
    width: 100%;
    max-width: 80ch;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .hero-rotator {
    position: relative;
    width: 100%;
    min-height: clamp(4.5rem, 8vw, 7rem);
    perspective: 1400px;
    perspective-origin: 50% 30%;
  }

  .hero-phrase {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: clamp(1.5rem, 3.4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: var(--color-text-1);
    text-wrap: wrap;
    max-width: 54ch;
    margin-inline: auto;
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.18em;
    opacity: 0;
    transform-style: preserve-3d;
    transform: translateY(75%) translateZ(-120px) rotateX(45deg);
    filter: blur(22px);
    animation: word-cycle var(--cycle) linear infinite;
    animation-delay: calc(var(--phase) * var(--slot) + var(--i) * var(--stagger));
    will-change: transform, opacity, filter;
  }

  .hero-word.is-accent {
    position: relative;
  }

  @keyframes word-cycle {
    0% {
      opacity: 0;
      transform: translateY(75%) translateZ(-120px) rotateX(45deg);
      filter: blur(22px);
    }
    1.5% {
      opacity: 0.4;
      transform: translateY(40%) translateZ(-60px) rotateX(22deg);
      filter: blur(12px);
    }
    3.5%,
    16% {
      opacity: 1;
      transform: translateY(0) translateZ(0) rotateX(0);
      filter: blur(0);
    }
    18% {
      opacity: 0.5;
      transform: translateY(-22%) translateZ(40px) rotateX(-12deg);
      filter: blur(10px);
    }
    19.5%,
    100% {
      opacity: 0;
      transform: translateY(-45%) translateZ(80px) rotateX(-22deg);
      filter: blur(20px);
    }
  }

  .hero-subline {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--color-text-1);
    line-height: 1.5;
    margin: 0;
    max-width: 48ch;
    text-wrap: balance;
    opacity: 0.9;
  }

  .hero-cta-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    transform: translateY(16px);
    animation: hero-cta-rise 1s var(--ease-out-expo) 0.6s forwards;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 2.5rem;
    background: linear-gradient(135deg, var(--color-brand-iris), var(--color-brand-grape));
    color: var(--color-text-1);
    border-radius: var(--radius-pill);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.12) inset,
      0 16px 50px -16px color-mix(in srgb, var(--color-brand-iris) 70%, transparent);
    transition:
      transform 0.3s var(--ease-out-expo),
      box-shadow 0.3s var(--ease-out-expo);
  }

  .hero-cta:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.16) inset,
      0 24px 60px -16px color-mix(in srgb, var(--color-brand-iris) 90%, transparent);
  }

  .hero-cta svg {
    transition: transform 0.3s var(--ease-out-expo);
  }
  .hero-cta:hover svg {
    transform: translateX(3px);
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: clamp(1.5rem, 3vw, 2.5rem);
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-2);
    background: color-mix(in srgb, var(--color-bg-elev) 60%, transparent);
    backdrop-filter: blur(8px);
    opacity: 0;
    animation:
      hero-hint-fade 0.6s var(--ease-out-expo) 1.4s forwards,
      hero-hint-bob 2.6s ease-in-out 2.4s infinite;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .hero-scroll-hint:hover {
    color: var(--color-text-1);
    border-color: var(--color-border-strong);
  }

  @keyframes hero-cta-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-hint-fade {
    to {
      opacity: 1;
    }
  }
  @keyframes hero-hint-bob {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-phrase:not(:first-child) {
      display: none;
    }
    .hero-phrase {
      position: static;
    }
    .hero-rotator {
      min-height: auto;
    }
    .hero-cta-row {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .hero-scroll-hint {
      animation: none;
      opacity: 1;
    }
  }
</style>
