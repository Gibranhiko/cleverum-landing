---
import { site } from '~/content/site';
import WhatsAppButton from '~/components/ui/WhatsAppButton.astro';

const { hero } = site;

interface Word {
  text: string;
  accent: boolean;
  index: number;
}

function parsePhrase(text: string): Word[] {
  const parts = text.split(/(\*[^*]+\*)/g).filter(Boolean);
  let i = 0;
  const out: Word[] = [];
  for (const part of parts) {
    const isAccent = part.startsWith('*') && part.endsWith('*');
    const clean = isAccent ? part.slice(1, -1) : part;
    for (const word of clean.split(/\s+/).filter(Boolean)) {
      out.push({ text: word, accent: isAccent, index: i++ });
    }
  }
  return out;
}

const phrases = hero.rotatingTitles.map((t) => ({
  text: t.replace(/\*/g, ''),
  words: parsePhrase(t),
}));

const PHRASE_COUNT = phrases.length;
const SLOT_SECONDS = 6;
const CYCLE_SECONDS = PHRASE_COUNT * SLOT_SECONDS;
const WORD_STAGGER_MS = 55;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-inner container-narrow">
    <h1 id="hero-title" class="sr-only">{phrases[0]?.text ?? 'Cleverum'}</h1>

    <div
      class="hero-rotator"
      aria-hidden="true"
      style={`--cycle: ${CYCLE_SECONDS}s; --slot: ${SLOT_SECONDS}s; --stagger: ${WORD_STAGGER_MS}ms;`}
    >
      {
        phrases.map((p, phaseIdx) => (
          <p class="hero-phrase font-display" style={`--phase: ${phaseIdx};`}>
            {p.words.map((w) => (
              <span
                class={`hero-word ${w.accent ? 'is-accent' : ''}`}
                style={`--i: ${w.index};`}
              >
                {w.accent ? <span class="gradient-text">{w.text}</span> : w.text}
              </span>
            ))}
          </p>
        ))
      }
    </div>

    <div class="hero-cta">
      <WhatsAppButton label={hero.ctaLabel} variant="secondary" size="lg" />
    </div>
  </div>

  <a href="#brands" class="hero-chevron" aria-label="Continuar al siguiente bloque">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    padding-block: clamp(7rem, 12vw, 10rem);
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: flex-start;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* ---- Rotator container ---- */
  .hero-rotator {
    position: relative;
    width: 100%;
    /* Espacio para la frase más larga: ~4 líneas */
    min-height: clamp(11rem, 22vw, 19rem);
    /* Habilita transforms 3D dentro */
    perspective: 1400px;
    perspective-origin: 50% 30%;
  }

  /* Cada frase ocupa el mismo espacio y se apila absoluta */
  .hero-phrase {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: var(--color-text-1);
    text-wrap: balance;
    max-width: 22ch;
    /* La frase como tal no tiene animación — la tienen sus palabras */
  }

  /* Cada palabra es un bloque inline-block que se anima */
  .hero-word {
    display: inline-block;
    margin-right: 0.18em;
    /* estado inicial (oculto, abajo, blur) */
    opacity: 0;
    transform-style: preserve-3d;
    transform: translateY(75%) translateZ(-120px) rotateX(45deg);
    filter: blur(22px);
    /* animación */
    animation: word-cycle var(--cycle) linear infinite;
    animation-delay: calc(var(--phase) * var(--slot) + var(--i) * var(--stagger));
    will-change: transform, opacity, filter;
  }

  /* Acento gradiente — usa el <span class="gradient-text"> interno
     pero también añadimos un sutil resplandor cuando la palabra esté visible */
  .hero-word.is-accent {
    position: relative;
  }

  /* Animación de la palabra dentro de su ciclo completo (cycle = phrase_count × slot).
     Cada frase tiene 1/count del ciclo como ventana visible. */
  @keyframes word-cycle {
    /* Hidden — esperando entrar */
    0% {
      opacity: 0;
      transform: translateY(75%) translateZ(-120px) rotateX(45deg);
      filter: blur(22px);
    }
    /* Easing intermedio — viene desde atrás */
    1.5% {
      opacity: 0.4;
      transform: translateY(40%) translateZ(-60px) rotateX(22deg);
      filter: blur(12px);
    }
    /* Asentada en su lugar */
    3.5% {
      opacity: 1;
      transform: translateY(0) translateZ(0) rotateX(0);
      filter: blur(0);
    }
    /* Hold visible (3.5% → 16% del ciclo total) */
    16% {
      opacity: 1;
      transform: translateY(0) translateZ(0) rotateX(0);
      filter: blur(0);
    }
    /* Inicio de salida — sube y se aleja */
    18% {
      opacity: 0.5;
      transform: translateY(-22%) translateZ(40px) rotateX(-12deg);
      filter: blur(10px);
    }
    /* Out — completamente oculta */
    19.5% {
      opacity: 0;
      transform: translateY(-45%) translateZ(80px) rotateX(-22deg);
      filter: blur(20px);
    }
    /* Mantén oculta hasta volver a empezar */
    100% {
      opacity: 0;
      transform: translateY(-45%) translateZ(80px) rotateX(-22deg);
      filter: blur(20px);
    }
  }

  /* Reduced motion → muestra solo la primera frase, sin animación */
  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-phrase:not(:first-child) {
      display: none;
    }
    .hero-phrase {
      position: static;
    }
    .hero-rotator {
      min-height: auto;
    }
  }

  /* ---- CTA ---- */
  .hero-cta {
    display: inline-flex;
    opacity: 0;
    transform: translateY(20px);
    animation: cta-rise 1s var(--ease-out-expo) 0.6s forwards;
  }

  @keyframes cta-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---- Chevron ---- */
  .hero-chevron {
    position: absolute;
    bottom: clamp(1.25rem, 3vw, 2.25rem);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-2);
    background: color-mix(in srgb, var(--color-bg-elev) 60%, transparent);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
    animation:
      chev-fade-in 0.6s var(--ease-out-expo) 1.4s forwards,
      chev-bob 2.6s ease-in-out 2.4s infinite;
  }

  .hero-chevron:hover {
    color: var(--color-text-1);
    border-color: var(--color-border-strong);
  }

  @keyframes chev-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes chev-bob {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta,
    .hero-chevron {
      animation: none;
      opacity: 1;
      transform: translateX(-50%);
    }
    .hero-cta {
      transform: none;
    }
  }
</style>
