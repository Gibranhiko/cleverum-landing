---
import { site } from '~/content/site';
import Eyebrow from '~/components/ui/Eyebrow.astro';

const { howWeWork } = site;
---

<section id="how" class="how" aria-labelledby="how-heading">
  <header class="how-head container-narrow">
    <Eyebrow text="EL PROCESO" />
    <h2 id="how-heading" class="how-title font-display">{howWeWork.heading}</h2>
    <p class="how-sub">{howWeWork.subheading}</p>
  </header>

  <div class="how-track container-narrow">
    <div class="how-track-line" aria-hidden="true">
      <div class="how-track-line-fill"></div>
    </div>

    <ol class="how-steps">
      {
        howWeWork.steps.map((s, i) => (
          <li class="how-step" style={`--i: ${i};`}>
            <span class="how-step-node" aria-hidden="true" />
            <span class="how-step-num font-display">{s.step}</span>
            <h3 class="how-step-title">{s.title}</h3>
            <p class="how-step-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    position: relative;
    padding-block: clamp(5rem, 10vw, 8rem);
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .how-head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    max-width: 720px;
  }

  .how-title {
    font-size: var(--fs-h1);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 0;
  }

  .how-sub {
    font-size: var(--fs-lead);
    color: var(--color-text-2);
    line-height: 1.55;
    max-width: 56ch;
  }

  .how-track {
    position: relative;
  }

  .how-track-line {
    position: absolute;
    top: 28px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
    overflow: hidden;
    display: none;
  }

  @media (min-width: 768px) {
    .how-track-line {
      display: block;
    }
  }

  .how-track-line-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-brand-blue),
      var(--color-brand-iris),
      var(--color-accent-go)
    );
    transform-origin: left center;
    transform: scaleX(0);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .how-track-line-fill {
        animation: line-fill linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 60%;
      }
    }
  }

  @keyframes line-fill {
    to {
      transform: scaleX(1);
    }
  }

  .how-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .how-steps {
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  .how-step {
    position: relative;
    padding-top: clamp(1.5rem, 2vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .how-step-node {
    position: absolute;
    top: 21px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-bg-base);
    border: 2px solid var(--color-brand-iris);
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-brand-iris) 60%, transparent);
  }

  .how-step:nth-child(1) .how-step-node {
    border-color: var(--color-brand-blue);
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-brand-blue) 60%, transparent);
  }
  .how-step:nth-child(2) .how-step-node {
    border-color: color-mix(in srgb, var(--color-brand-blue) 60%, var(--color-brand-iris));
  }
  .how-step:nth-child(3) .how-step-node {
    border-color: var(--color-brand-iris);
  }
  .how-step:nth-child(4) .how-step-node {
    border-color: var(--color-accent-go);
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent-go) 60%, transparent);
  }

  .how-step-num {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-3);
    margin-bottom: 0.25rem;
    line-height: 1;
  }

  .how-step-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--color-text-1);
    margin: 0;
  }

  .how-step-body {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--color-text-2);
    margin: 0;
    max-width: 26ch;
  }
</style>
