---
import { site } from '~/content/site';

const { manifesto } = site;

const accentToVar: Record<string, string> = {
  blue: 'var(--color-brand-blue)',
  iris: 'var(--color-brand-iris)',
  green: 'var(--color-accent-go)',
};
---

<section id="manifesto" class="manifesto" aria-labelledby="manifesto-label">
  <span id="manifesto-label" class="manifesto-label">{manifesto.heading}</span>

  <p class="manifesto-text font-display">
    {
      manifesto.words.map((w) => (
        <span
          class={`manifesto-word ${w.accent ? `accent-${w.accent}` : ''}`}
          style={w.accent ? `--accent-color: ${accentToVar[w.accent]};` : undefined}
        >
          {w.text}
        </span>
      ))
    }
  </p>
</section>

<style>
  .manifesto {
    position: relative;
    min-height: 120vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    padding-block: clamp(6rem, 12vw, 10rem);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .manifesto-label {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-3);
    font-weight: 500;
  }

  .manifesto-text {
    max-width: 22ch;
    text-align: center;
    font-size: var(--fs-display);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }

  .manifesto-word {
    display: inline;
    color: var(--color-text-1);
    /* Estado inicial (visible cuando no hay soporte de animation-timeline) */
    opacity: 1;
    font-weight: 600;
    transition: color 0.3s ease;
    margin-inline-end: 0.18em;
  }

  /* Reveal palabra-por-palabra con CSS scroll-driven animations */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .manifesto-word {
        opacity: 0.16;
        font-weight: 300;
        animation-name: word-reveal;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 25% cover 55%;
      }
      .manifesto-word.accent-blue {
        animation-name: word-reveal-blue;
      }
      .manifesto-word.accent-iris {
        animation-name: word-reveal-iris;
      }
      .manifesto-word.accent-green {
        animation-name: word-reveal-green;
      }
    }
  }

  @keyframes word-reveal {
    to {
      opacity: 1;
      font-weight: 700;
    }
  }
  @keyframes word-reveal-blue {
    to {
      opacity: 1;
      font-weight: 700;
      color: var(--color-brand-blue);
    }
  }
  @keyframes word-reveal-iris {
    to {
      opacity: 1;
      font-weight: 700;
      color: var(--color-brand-iris);
    }
  }
  @keyframes word-reveal-green {
    to {
      opacity: 1;
      font-weight: 700;
      color: var(--color-accent-go);
    }
  }

  /* Fallback estático para navegadores sin animation-timeline o reduced-motion */
  .manifesto-word.accent-blue {
    color: var(--color-brand-blue);
  }
  .manifesto-word.accent-iris {
    color: var(--color-brand-iris);
  }
  .manifesto-word.accent-green {
    color: var(--color-accent-go);
  }
</style>
