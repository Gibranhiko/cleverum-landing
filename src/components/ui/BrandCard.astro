---
import type { Brand } from '~/content/site';
import { accentVar } from '~/content/site';
import YouTubeLite from './YouTubeLite.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  brand: Brand;
  index: number;
}

const { brand, index } = Astro.props;
const accent = accentVar[brand.accent];
const stickyTop = `${5 + index * 2.5}vh`;
const initial = brand.name.charAt(0);
---

<article
  class="brand-card"
  data-brand={brand.id}
  style={`--accent: ${accent}; --sticky-top: ${stickyTop};`}
>
  <div class="brand-card-inner">
    <div class="brand-card-body">
      <div class="brand-card-content">
        <header class="brand-card-head">
          <div class="brand-card-logo" aria-label={`Logo de ${brand.name} — placeholder`}>
            {
              brand.logoSrc ? (
                <img src={brand.logoSrc} alt={`${brand.name} logo`} width="56" height="56" />
              ) : (
                <span class="brand-card-logo-initial font-display">{initial}</span>
              )
            }
          </div>
          <div class="brand-card-meta">
            <span class="brand-card-num">{brand.number}</span>
            <span class="brand-card-name">{brand.name}</span>
          </div>
        </header>

        <h2 class="brand-card-tagline font-display">{brand.tagline}</h2>
        <p class="brand-card-desc">{brand.description}</p>

        <ul class="brand-card-bullets" role="list">
          {
            brand.bullets.map((b) => (
              <li>
                <span class="brand-card-bullet-dot" aria-hidden="true" />
                <span>{b}</span>
              </li>
            ))
          }
        </ul>

        <div class="brand-card-cta">
          <WhatsAppButton
            label={`Hablemos de ${brand.name}`}
            message={brand.ctaMessage}
            variant="secondary"
            size="md"
          />
        </div>
      </div>

      <div class="brand-card-media">
        <YouTubeLite
          id={brand.youtubeId}
          title={`${brand.name} — ${brand.tagline}`}
          placeholder={brand.videoPlaceholder}
          accentColor={accent}
        />
      </div>
    </div>
  </div>
</article>

<style>
  .brand-card {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 900px) {
    .brand-card {
      position: sticky;
      top: var(--sticky-top);
    }
  }

  .brand-card-inner {
    position: relative;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background:
      radial-gradient(
        80% 100% at 100% 0%,
        color-mix(in srgb, var(--accent) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg-elev);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 40px 80px -40px color-mix(in srgb, var(--accent) 50%, transparent);
    overflow: hidden;
    isolation: isolate;
  }

  .brand-card-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.6;
  }

  .brand-card-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .brand-card-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .brand-card-content {
    display: flex;
    flex-direction: column;
  }

  /* Header con logo + número/nombre */
  .brand-card-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .brand-card-logo {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--accent) 10%, var(--color-bg-soft));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--color-border));
    display: grid;
    place-items: center;
    color: var(--accent);
    position: relative;
    overflow: hidden;
  }

  /* Indicador visual de placeholder: borde punteado interno */
  .brand-card-logo:not(:has(img))::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 11px;
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    pointer-events: none;
  }

  .brand-card-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-card-logo-initial {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .brand-card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand-card-num {
    font-family: var(--font-display);
    font-feature-settings: 'tnum';
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.12em;
  }

  .brand-card-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-1);
    line-height: 1;
  }

  .brand-card-tagline {
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--color-text-1);
    text-wrap: balance;
  }

  .brand-card-desc {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--color-text-2);
    margin: 0 0 1.75rem;
    max-width: 44ch;
  }

  .brand-card-bullets {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .brand-card-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    font-size: var(--fs-body);
    color: var(--color-text-1);
    line-height: 1.5;
  }

  .brand-card-bullet-dot {
    flex: 0 0 8px;
    width: 8px;
    height: 8px;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .brand-card-cta {
    display: inline-flex;
  }

  .brand-card-media {
    width: 100%;
  }
</style>
