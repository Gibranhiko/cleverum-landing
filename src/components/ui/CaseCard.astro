---
import type { Case } from '~/content/site';

interface Props {
  case: Case;
  index?: number;
}

const { case: c, index = 0 } = Astro.props;

const accents: Record<string, string> = {
  'whatsapp-panel': 'var(--color-accent-go)',
  web: 'var(--color-brand-blue)',
  automation: 'var(--color-brand-iris)',
};
const accent = accents[c.id] ?? 'var(--color-brand-iris)';
---

<article
  class="case-card"
  style={`--accent: ${accent}; --card-index: ${index};`}
  data-case-id={c.id}
>
  <div class="case-media">
    {
      c.videoId ? (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${c.videoId}?start=2&rel=0`}
          title={`${c.solution} — video del producto`}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      ) : c.mediaSrc ? (
        <img src={c.mediaSrc} alt={`${c.solution} — captura del producto`} loading="lazy" />
      ) : (
        <div class="case-media-placeholder" aria-hidden="true">
          <div class="case-media-icon">
            {c.id === 'whatsapp-panel' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="56"
                height="56"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z" />
              </svg>
            )}
            {c.id === 'web' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="56"
                height="56"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                <line x1="8" x2="16" y1="21" y2="21" />
                <line x1="12" x2="12" y1="17" y2="21" />
              </svg>
            )}
            {c.id === 'automation' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="56"
                height="56"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
              </svg>
            )}
          </div>
          <span class="case-media-text">Próxima captura · Mockup en proceso</span>
        </div>
      )
    }
  </div>

  <div class="case-text">
    <header class="case-header">
      <span class="case-number font-display" aria-hidden="true">{c.number}</span>
      <h3 class="case-title font-display">{c.solution}</h3>
    </header>

    <div class="case-body">
      <p class="case-problem">{c.problem}</p>
      <p class="case-impact">{c.impact}</p>
    </div>

    <footer class="case-stack" aria-label="Stack utilizado">
      {c.stack.map((s) => <span class="case-stack-chip">{s}</span>)}
    </footer>

    {
      c.link && (
        <a class="case-link" href={c.link} target="_blank" rel="noopener noreferrer">
          Ver caso
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 17 7" />
            <path d="M7 7h10v10" />
          </svg>
        </a>
      )
    }
  </div>
</article>

<style>
  .case-card {
    position: sticky;
    top: calc(5.5rem + var(--card-index, 0) * 1.5rem);
    z-index: calc(var(--card-index, 0) + 1);
    background: color-mix(in srgb, var(--color-bg-elev) 94%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    align-items: center;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    transition: border-color 0.3s ease;
    box-shadow: 0 -10px 30px -16px rgba(0, 0, 0, 0.55);
  }

  /* Desktop side-by-side: media izquierda, texto derecha */
  @media (min-width: 960px) {
    .case-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.5rem);
      padding: clamp(1.75rem, 3vw, 2.25rem);
    }
  }

  .case-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--color-border));
  }

  /* Mobile: fallback a flujo normal — sticky con offsets queda apretado */
  @media (max-width: 768px) {
    .case-card {
      position: static;
      box-shadow: none;
    }
  }

  .case-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.7;
  }

  /* Media column */
  .case-media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-soft);
    width: 100%;
  }

  .case-media img,
  .case-media iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }

  .case-media img {
    object-fit: cover;
  }

  .case-media-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background:
      radial-gradient(
        ellipse at 25% 35%,
        color-mix(in srgb, var(--accent) 42%, transparent),
        transparent 55%
      ),
      radial-gradient(
        ellipse at 75% 70%,
        color-mix(in srgb, var(--accent) 28%, transparent),
        transparent 50%
      ),
      var(--color-bg-soft);
    color: color-mix(in srgb, var(--accent) 70%, white);
  }

  .case-media-icon {
    display: inline-flex;
    opacity: 0.85;
  }

  .case-media-text {
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-text-2) 90%, transparent);
  }

  /* Text column */
  .case-text {
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 1.8vw, 1.25rem);
    min-width: 0;
  }

  .case-header {
    display: flex;
    align-items: baseline;
    gap: clamp(0.75rem, 1.5vw, 1rem);
    flex-wrap: wrap;
  }

  .case-number {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    color: var(--accent);
    line-height: 0.85;
    opacity: 0.9;
  }

  .case-title {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-1);
    margin: 0;
    line-height: 1.15;
    text-wrap: balance;
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .case-problem {
    color: var(--color-text-2);
    margin: 0;
  }

  .case-impact {
    color: var(--color-text-1);
    font-weight: 500;
    margin: 0;
  }

  .case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .case-stack-chip {
    padding: 0.32rem 0.7rem;
    font-size: 0.74rem;
    font-weight: 500;
    background: color-mix(in srgb, var(--color-bg-base) 65%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    color: var(--color-text-2);
    white-space: nowrap;
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    width: fit-content;
    transition:
      gap 0.2s ease,
      color 0.2s ease;
  }

  .case-link:hover {
    color: var(--color-text-1);
    gap: 0.6rem;
  }

  /* Reduced motion: cards comparten el mismo top (sin offset incremental) */
  @media (prefers-reduced-motion: reduce) {
    .case-card {
      top: 5.5rem;
      transition: none;
    }
  }
</style>
