---
interface Props {
  text: string;
  class?: string;
  dotColor?: string;
}
const { text, class: extraClass = '', dotColor = 'var(--color-brand-iris)' } = Astro.props;
---

<span class={`eyebrow ${extraClass}`}>
  <span class="eyebrow-dot" style={`--dot: ${dotColor};`} aria-hidden="true"></span>
  {text}
</span>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-text-2);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-elev) 60%, transparent);
    backdrop-filter: blur(6px);
  }
  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 12px var(--dot);
    animation: eyebrow-pulse 2.4s ease-in-out infinite;
  }
  @keyframes eyebrow-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow-dot { animation: none; opacity: 1; }
  }
</style>
