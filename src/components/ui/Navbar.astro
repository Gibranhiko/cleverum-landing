---
import { site } from '~/content/site';
import WhatsAppButton from './WhatsAppButton.astro';

const navLinks = [
  { label: 'Diagnóstico', href: '/#diagnostico' },
  { label: 'Casos', href: '/#cases' },
  { label: 'Servicios', href: '/#services' },
  { label: 'Blog', href: '/#blog' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="#hero" class="nav-brand" aria-label={`${site.brand.name} — Inicio`}>
      <span class="nav-brand-mark" aria-hidden="true">
        <img src="/logos/cleverum-logo.png" alt="" width="32" height="32" loading="eager" />
      </span>
      <span class="nav-brand-text">
        <span class="nav-brand-name font-display">{site.brand.name}</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Navegación principal">
      {
        navLinks.map((l) => (
          <a class="nav-link" href={l.href}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-cta">
      <WhatsAppButton label="Conecta por WhatsApp" variant="secondary" size="sm" iconOnly />

      <button
        type="button"
        class="nav-burger"
        data-nav-burger
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
      >
        <span class="nav-burger-line"></span>
        <span class="nav-burger-line"></span>
        <span class="nav-burger-line"></span>
      </button>
    </div>
  </div>

  <div class="nav-mobile" id="nav-mobile-menu" data-nav-mobile>
    <nav class="nav-mobile-links" aria-label="Navegación móvil">
      {
        navLinks.map((l) => (
          <a class="nav-mobile-link" href={l.href} data-nav-mobile-link>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    const nav = document.querySelector('[data-nav]');
    if (!nav) return;
    let ticking = false;
    const apply = () => {
      ticking = false;
      nav.classList.toggle('is-scrolled', window.scrollY > 16);
    };
    apply();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );

    // Menú móvil
    const burger = nav.querySelector('[data-nav-burger]');
    const menu = nav.querySelector('[data-nav-mobile]');
    if (burger && menu) {
      const setOpen = (open) => {
        nav.classList.toggle('is-menu-open', open);
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      };
      burger.addEventListener('click', () => {
        setOpen(!nav.classList.contains('is-menu-open'));
      });
      menu.querySelectorAll('[data-nav-mobile-link]').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('is-menu-open')) setOpen(false);
      });
    }
  })();
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 0.5rem clamp(1rem, 3vw, 2rem);
    transition:
      background-color 0.4s var(--ease-out-expo),
      border-color 0.4s var(--ease-out-expo),
      backdrop-filter 0.4s var(--ease-out-expo);
    background: transparent;
    border-bottom: 1px solid transparent;
  }

  .nav.is-scrolled {
    background: color-mix(in srgb, var(--color-bg-base) 65%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1280px;
    margin-inline: auto;
    padding: 0.5rem 0;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text-1);
    transition: opacity 0.2s ease;
  }
  .nav-brand:hover {
    opacity: 0.85;
  }

  .nav-brand-mark {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    overflow: hidden;
    flex: 0 0 32px;
  }

  .nav-brand-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nav-brand-text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    gap: 2px;
  }

  .nav-brand-name {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .nav-brand-bajada {
    font-size: 0.72rem;
    color: var(--color-text-3);
    letter-spacing: 0.01em;
    font-weight: 400;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  @media (min-width: 860px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-small);
    color: var(--color-text-2);
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: color 0.2s ease;
    position: relative;
  }

  a.nav-link::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-brand-iris);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out-expo);
  }

  a.nav-link:hover {
    color: var(--color-text-1);
  }

  a.nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* --- Hamburguesa (solo mobile) --- */
  .nav-burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 11px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-elev) 55%, transparent);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-burger:hover {
    border-color: var(--color-border-strong);
  }

  @media (min-width: 860px) {
    .nav-burger {
      display: none;
    }
  }

  .nav-burger-line {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-text-1);
    border-radius: 2px;
    transition:
      transform 0.3s var(--ease-out-expo),
      opacity 0.2s ease;
  }

  .nav.is-menu-open .nav-burger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav.is-menu-open .nav-burger-line:nth-child(2) {
    opacity: 0;
  }
  .nav.is-menu-open .nav-burger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* --- Panel móvil --- */
  .nav-mobile {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      max-height 0.4s var(--ease-out-expo),
      opacity 0.3s ease,
      visibility 0s linear 0.4s;
  }

  .nav.is-menu-open .nav-mobile {
    max-height: 24rem;
    opacity: 1;
    visibility: visible;
    transition:
      max-height 0.4s var(--ease-out-expo),
      opacity 0.3s ease,
      visibility 0s;
  }

  @media (min-width: 860px) {
    .nav-mobile {
      display: none;
    }
  }

  .nav-mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 1280px;
    margin-inline: auto;
    padding: 0.75rem 0 1.25rem;
  }

  .nav-mobile-link {
    display: block;
    padding: 0.85rem 0.75rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-2);
    border-radius: 10px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-mobile-link:hover,
  .nav-mobile-link:focus-visible {
    color: var(--color-text-1);
    background: color-mix(in srgb, var(--color-brand-iris) 10%, transparent);
  }

  /* El panel abierto necesita el fondo glass aunque no haya scroll */
  .nav.is-menu-open {
    background: color-mix(in srgb, var(--color-bg-base) 88%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: var(--color-border);
  }

  @media (max-width: 480px) {
    .nav-brand-text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-burger-line,
    .nav-mobile {
      transition: none;
    }
  }
</style>
