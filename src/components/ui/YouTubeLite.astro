---
import { YouTube } from '@astro-community/astro-embed-youtube';

interface Props {
  id: string | null;
  title: string;
  placeholder?: string;
  accentColor?: string;
  class?: string;
}

const {
  id,
  title,
  placeholder = 'Próximamente — estamos preparando el video.',
  accentColor = 'var(--color-brand-iris)',
  class: extraClass = '',
} = Astro.props;
---

{
  id ? (
    <div class={`yt-frame ${extraClass}`} style={`--accent: ${accentColor};`}>
      <YouTube id={id} title={title} poster="hqdefault" params="rel=0&modestbranding=1" />
    </div>
  ) : (
    <div
      class={`yt-placeholder ${extraClass}`}
      style={`--accent: ${accentColor};`}
      role="img"
      aria-label={`Video próximamente: ${title}`}
    >
      <div class="yt-placeholder-inner">
        <span class="yt-placeholder-badge">Próximamente</span>
        <p class="yt-placeholder-text">{placeholder}</p>
        <span class="yt-placeholder-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </div>
      <span class="yt-placeholder-grid" aria-hidden="true"></span>
    </div>
  )
}

<style>
  .yt-frame,
  .yt-placeholder {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elev);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 30px 60px -30px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .yt-frame :global(lite-youtube) {
    border-radius: var(--radius-card);
    width: 100%;
    height: 100%;
  }

  /* ---- Placeholder ---- */
  .yt-placeholder-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
    z-index: 1;
    background: radial-gradient(
      60% 60% at 50% 50%,
      color-mix(in srgb, var(--accent) 15%, transparent),
      transparent 70%
    );
  }

  .yt-placeholder-badge {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-weight: 500;
  }

  .yt-placeholder-text {
    font-size: var(--fs-body);
    color: var(--color-text-2);
    max-width: 32ch;
    line-height: 1.5;
  }

  .yt-placeholder-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    backdrop-filter: blur(6px);
  }

  .yt-placeholder-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.4;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--accent) 10%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--accent) 10%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(60% 60% at 50% 50%, black, transparent 75%);
  }
</style>
