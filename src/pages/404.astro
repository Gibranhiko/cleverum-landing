---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex={true}>
  <section
    style="min-height:80dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:clamp(3rem,8vw,6rem) clamp(1.25rem,4vw,3rem);gap:1.5rem;"
  >
    <p
      style="font-size:clamp(5rem,20vw,10rem);font-weight:800;line-height:1;letter-spacing:-0.05em;background:linear-gradient(135deg,var(--color-brand-iris),var(--color-brand-grape));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:0;"
      aria-hidden="true"
    >
      404
    </p>

    <h1
      style="font-size:clamp(1.4rem,3vw,2rem);font-weight:700;letter-spacing:-0.02em;color:var(--color-text-1);margin:0;"
    >
      Esta página no existe.
    </h1>

    <p style="font-size:1rem;color:var(--color-text-2);max-width:38ch;line-height:1.6;margin:0;">
      Puede que la URL esté mal escrita o que la página haya sido movida. Sin drama — vuelve al inicio.
    </p>

    <a
      href="/"
      style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.9rem 2rem;background:linear-gradient(135deg,var(--color-brand-iris),var(--color-brand-grape));color:var(--color-text-1);border-radius:9999px;font-size:0.95rem;font-weight:600;text-decoration:none;margin-top:0.5rem;transition:transform 0.2s,box-shadow 0.2s;box-shadow:0 8px 30px -8px color-mix(in srgb,var(--color-brand-iris) 60%,transparent);"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Volver al inicio
    </a>
  </section>
</BaseLayout>
