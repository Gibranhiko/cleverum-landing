---
import '~/styles/global.css';
import '~/components/cotizaciones/proposal.css';
import { ClientRouter } from 'astro:transitions';

const validUntil = '31 de agosto de 2026';

const whatsappMsg = encodeURIComponent(
  '¡Hola Cleverum! Vi la propuesta de GoBox y me interesa avanzar.',
);
const whatsappUrl = `https://wa.me/5215541433545?text=${whatsappMsg}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>GoBox MVP — Propuesta de desarrollo · Cleverum</title>
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <ClientRouter />
  </head>

  <body class="gb-body">

    <!-- ── TOPBAR ──────────────────────────────────────────────── -->
    <header class="proposal-topbar">
      <div class="proposal-topbar-inner">
        <div class="proposal-topbar-brand">
          <img src="/logos/cleverum-logo.png" alt="Cleverum" class="proposal-topbar-logo" />
          <span class="proposal-topbar-name">Cleverum</span>
        </div>
        <div class="proposal-topbar-meta">
          <span class="proposal-badge gb-badge">Propuesta GoBox</span>
          <span class="proposal-validity">Válida hasta {validUntil}</span>
        </div>
      </div>
    </header>

    <main>

      <!-- ── 1. HERO ──────────────────────────────────────────── -->
      <section class="gb-hero">
        <!-- Decoradores geométricos SVG — solo desktop -->
        <svg class="gb-deco gb-deco--left" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 130 500">
          <polygon points="0,0 90,0 130,250 90,500 0,500" fill="#0D2540" opacity="0.10"/>
          <polygon points="0,0 55,0  95,250  55,500 0,500" fill="#0D2540" opacity="0.06"/>
          <polygon points="78,152 130,205 78,258" fill="#F07820" opacity="0.55"/>
        </svg>
        <svg class="gb-deco gb-deco--right" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 130 500">
          <polygon points="130,0 40,0 0,250 40,500 130,500" fill="#F07820" opacity="0.22"/>
          <polygon points="130,0 75,0 35,250 75,500 130,500" fill="#F07820" opacity="0.12"/>
          <polygon points="52,175 0,228 52,280" fill="#0D2540" opacity="0.12"/>
        </svg>
        <div class="gb-hero-content">
          <p class="gb-eyebrow reveal-up">Propuesta de Desarrollo · Cleverum para GoBox</p>
          <img
            src="/cotizaciones/gobox/go-box-logo.png"
            alt="GoBox"
            class="gb-hero-logo reveal-up"
            style="animation-delay:.06s"
          />
          <p class="gb-hero-sub reveal-up" style="animation-delay:.12s">
            Tu casillero en Estados Unidos: membresías, dirección de recepción y servicio de pickup.
          </p>
          <div class="gb-price-pill reveal-up" style="animation-delay:.18s">
            <span class="gb-price-amount">$80,000 MXN</span>
            <span class="gb-price-tax">+ IVA</span>
          </div>
          <p class="gb-valid-until reveal-up" style="animation-delay:.22s">
            Propuesta válida hasta el {validUntil}
          </p>
          <a href="#diagrama" class="gb-hero-arrow reveal-up" aria-label="Ver la propuesta" style="animation-delay:.26s">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
          </a>
        </div>
      </section>

      <!-- ── DIAGRAMA MVP ───────────────────────────────────────── -->
      <section id="diagrama" class="gb-section gb-section--alt">
        <div class="gb-container gb-container--wide">
          <p class="gb-section-label reveal-up">Así funciona el MVP</p>
          <h2 class="gb-section-title reveal-up" style="animation-delay:.06s">
            Procesos digitales y manuales
          </h2>
          <p class="gb-body-text reveal-up" style="animation-delay:.1s; margin-bottom:2rem; max-width:68ch;">
            El sistema hace lo que puede automatizarse. Tu equipo hace lo que requiere presencia física.
            Así arrancas con la menor fricción y el mayor control.
          </p>

          <!-- Leyenda -->
          <div class="gb-legend reveal-up" style="animation-delay:.14s">
            <span class="gb-legend-item">
              <span class="gb-legend-dot gb-legend-dot--digital"></span>
              <span><strong>Sistema</strong> — GoBox lo hace automáticamente</span>
            </span>
            <span class="gb-legend-item">
              <span class="gb-legend-dot gb-legend-dot--manual"></span>
              <span><strong>Manual</strong> — Tu equipo lo hace a mano</span>
            </span>
          </div>

          <!-- Diagrama de flujo -->
          <div class="gb-flow reveal-up" style="animation-delay:.18s">

            <!-- Columna 1: CLIENTE -->
            <div class="gb-flow-col">
              <div class="gb-flow-header gb-flow-header--navy">
                <span class="gb-flow-num">01</span>
                <span class="gb-flow-title">CLIENTE</span>
                <span class="gb-flow-sub">Portal del socio</span>
              </div>
              <ul class="gb-flow-steps">
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Registro y verificación de correo</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Suite USA asignada (dirección única)</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Ve el estado de sus paquetes desde su portal</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Paga su membresía en línea (Stripe)</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Solicita pickup urgente desde su portal</span>
                </li>
              </ul>
            </div>

            <div class="gb-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>

            <!-- Columna 2: BODEGA -->
            <div class="gb-flow-col">
              <div class="gb-flow-header gb-flow-header--orange">
                <span class="gb-flow-num">02</span>
                <span class="gb-flow-title">BODEGA</span>
                <span class="gb-flow-sub">Registro y operación</span>
              </div>
              <ul class="gb-flow-steps">
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                  <span>Recibe el paquete físicamente en bodega</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                  <span>Da de alta el paquete en el panel (tracking + datos)</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                  <span>Actualiza el estado del paquete a mano</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Notifica al cliente por correo: paquete recibido</span>
                </li>
              </ul>
            </div>

            <div class="gb-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>

            <!-- Columna 3: MEMBRESÍAS -->
            <div class="gb-flow-col">
              <div class="gb-flow-header gb-flow-header--navy">
                <span class="gb-flow-num">03</span>
                <span class="gb-flow-title">MEMBRESÍAS</span>
                <span class="gb-flow-sub">Cobro y activación</span>
              </div>
              <ul class="gb-flow-steps">
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Cliente paga su membresía en línea (Stripe)</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                  <span>Staff confirma el pago en Stripe y activa la membresía en el panel</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Cliente ve su membresía activa y su Suite USA</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Correo de bienvenida automático con sus datos</span>
                </li>
              </ul>
            </div>

            <div class="gb-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>

            <!-- Columna 4: RETIRO EN BODEGA -->
            <div class="gb-flow-col">
              <div class="gb-flow-header gb-flow-header--orange">
                <span class="gb-flow-num">04</span>
                <span class="gb-flow-title">RETIRO</span>
                <span class="gb-flow-sub">Pickup en bodega</span>
              </div>
              <ul class="gb-flow-steps">
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Cliente ve "listo para retiro" en su portal</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                  <span>Acude a la bodega y verifica su identidad</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                  <span>Staff entrega el paquete físicamente</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                  <span>Staff marca como ENTREGADO en el panel</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                  <span>Correo de confirmación — ciclo cerrado</span>
                </li>
              </ul>
            </div>

          </div><!-- /gb-flow -->

          <!-- Tarjeta: Pickup Urgente (feature destacado) -->
          <div class="gb-urgente reveal-up" style="animation-delay:.20s">
            <div class="gb-urgente-header">
              <span class="gb-urgente-icon">⚡</span>
              <div>
                <span class="gb-urgente-label">Servicio incluido en el MVP</span>
                <h3 class="gb-urgente-title">Pickup Urgente</h3>
              </div>
            </div>
            <p class="gb-urgente-desc">
              El cliente solicita desde su portal que el staff pase a comprar o recoger un artículo
              en una tienda cercana. El pedido queda registrado en el sistema; el staff lo atiende
              manualmente y actualiza el estado.
            </p>
            <div class="gb-urgente-steps">
              <span class="gb-flow-step" style="gap:.5rem">
                <span class="gb-step-tag gb-step-tag--digital">Sistema</span>
                <span>Cliente solicita y describe el artículo</span>
              </span>
              <span class="gb-urgente-sep" aria-hidden="true">→</span>
              <span class="gb-flow-step" style="gap:.5rem">
                <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                <span>Staff recoge el artículo en tienda</span>
              </span>
              <span class="gb-urgente-sep" aria-hidden="true">→</span>
              <span class="gb-flow-step" style="gap:.5rem">
                <span class="gb-step-tag gb-step-tag--manual">Manual</span>
                <span>Registra y atiende el servicio en el panel</span>
              </span>
            </div>
          </div>

          <!-- Panel transversal: Administración -->
          <div class="gb-flow-admin reveal-up" style="animation-delay:.22s">
            <div class="gb-flow-admin-label">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              Panel de Administración — transversal a todo el proceso
            </div>
            <p class="gb-flow-admin-desc">
              Tu equipo gestiona desde un solo panel: clientes activos, paquetes en bodega, membresías y solicitudes de pickup. Sin saltar entre herramientas.
            </p>
          </div>

        </div>
      </section>

      <!-- ── 4. COMPARATIVA ──────────────────────────────────────── -->
      <section class="gb-section">
        <div class="gb-container">
          <p class="gb-section-label reveal-up">Por qué a la medida</p>
          <h2 class="gb-section-title reveal-up" style="animation-delay:.06s">GoBox vs. software genérico</h2>
          <p class="gb-body-text gb-container--narrow reveal-up" style="animation-delay:.1s; margin: 0 auto 2.5rem;">
            Existe software empaquetado de package forwarding (MyUS, Stackry, Shipito, etc.), pero está diseñado para el mercado global en inglés, con modelos rígidos que no se adaptan a México. Puedes rentarlo, pero lo que obtienes es una caja que alguien más controla.
          </p>

          <div class="gb-compare-grid reveal-up" style="animation-delay:.14s">
            <div class="gb-compare-col gb-compare-col--generic">
              <div class="gb-compare-header">
                <span class="gb-compare-tag gb-compare-tag--neutral">Software empaquetado</span>
                <p class="gb-compare-subhead">licencia / renta mensual</p>
              </div>
              <ul class="gb-compare-list">
                <li class="gb-compare-item gb-compare-item--bad">Licencia desde ~$1,700 USD (~$30,000 MXN) o renta mensual encima</li>
                <li class="gb-compare-item gb-compare-item--bad">En inglés, pensado para el mercado global</li>
                <li class="gb-compare-item gb-compare-item--bad">No factura CFDI de forma nativa</li>
                <li class="gb-compare-item gb-compare-item--bad">Sin notificaciones por WhatsApp de forma nativa</li>
                <li class="gb-compare-item gb-compare-item--bad">Modelo de cobro rígido, difícil de adaptar a tu operación</li>
                <li class="gb-compare-item gb-compare-item--bad">Personalizarlo cuesta aparte y queda frágil ante actualizaciones</li>
                <li class="gb-compare-item gb-compare-item--bad">Dependes de una empresa externa que puede subir precios o cerrar</li>
              </ul>
            </div>

            <div class="gb-compare-col gb-compare-col--custom">
              <div class="gb-compare-header">
                <span class="gb-compare-tag gb-compare-tag--accent">GoBox a la medida</span>
                <p class="gb-compare-subhead">tuyo, sin ataduras</p>
              </div>
              <ul class="gb-compare-list">
                <li class="gb-compare-item gb-compare-item--good">100% tuyo, sin renta mensual de licencia</li>
                <li class="gb-compare-item gb-compare-item--good">En español y pensado para tu operación en México</li>
                <li class="gb-compare-item gb-compare-item--good">Preparado para crecer con CFDI, WhatsApp y envíos cuando lo necesites</li>
                <li class="gb-compare-item gb-compare-item--good">Adaptado exactamente a tu modelo de membresías y servicios</li>
                <li class="gb-compare-item gb-compare-item--good">Sin ataduras a ningún proveedor externo</li>
              </ul>
            </div>
          </div>

          <div class="gb-compare-honest reveal-up" style="animation-delay:.18s">
            "Si solo necesitas algo genérico y en inglés, el software empaquetado puede ser más barato.
            GoBox tiene sentido cuando quieres un sistema hecho para tu negocio, en tu idioma y que sea tuyo."
          </div>
        </div>
      </section>

      <!-- ── 5. SIGUIENTES FASES ─────────────────────────────────── -->
      <section class="gb-section gb-section--alt">
        <div class="gb-container gb-container--narrow">
          <p class="gb-section-label reveal-up">Hoja de ruta</p>
          <h2 class="gb-section-title reveal-up" style="animation-delay:.06s">Las siguientes fases</h2>
          <div class="gb-phases reveal-up" style="animation-delay:.1s">
            <div class="gb-phase">
              <span class="gb-phase-num">Fase 2</span>
              <div>
                <h3 class="gb-phase-title">Logística a México</h3>
                <p class="gb-phase-desc">Envíos, consolidación de paquetes y seguimiento de última milla.</p>
              </div>
            </div>
            <div class="gb-phase">
              <span class="gb-phase-num">Fase 3</span>
              <div>
                <h3 class="gb-phase-title">Servicios adicionales</h3>
                <p class="gb-phase-desc">Compra asistida, facturación CFDI y notificaciones por WhatsApp.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── 6. INVERSIÓN ────────────────────────────────────────── -->
      <section class="gb-section">
        <div class="gb-container gb-container--narrow">
          <p class="gb-section-label reveal-up">Inversión</p>
          <h2 class="gb-section-title reveal-up" style="animation-delay:.06s">¿Cuánto cuesta?</h2>

          <div class="gb-investment-hero reveal-up" style="animation-delay:.1s">
            <span class="gb-investment-amount">$80,000 <small>MXN + IVA</small></span>
          </div>

          <div class="gb-payment-grid reveal-up" style="animation-delay:.14s">
            <div class="gb-payment-step">
              <span class="gb-payment-pct">40%</span>
              <span class="gb-payment-label">Al iniciar</span>
              <span class="gb-payment-sub">$32,000 MXN + IVA</span>
            </div>
            <div class="gb-payment-divider" aria-hidden="true">→</div>
            <div class="gb-payment-step">
              <span class="gb-payment-pct">30%</span>
              <span class="gb-payment-label">MVP funcional</span>
              <span class="gb-payment-sub">$24,000 MXN + IVA</span>
            </div>
            <div class="gb-payment-divider" aria-hidden="true">→</div>
            <div class="gb-payment-step">
              <span class="gb-payment-pct">30%</span>
              <span class="gb-payment-label">Paso a producción</span>
              <span class="gb-payment-sub">$24,000 MXN + IVA</span>
            </div>
          </div>

          <div class="gb-timeline-pill reveal-up" style="animation-delay:.18s">
            ⏱ Tiempo estimado: <strong>5–7 semanas</strong>
            <span class="gb-timeline-note">Incluye una semana inicial de definición de alcance antes de programar.</span>
          </div>
        </div>
      </section>

      <!-- ── 7. COSTOS DE OPERACIÓN ──────────────────────────────── -->
      <section class="gb-section gb-section--alt">
        <div class="gb-container gb-container--narrow">
          <p class="gb-section-label reveal-up">Operación</p>
          <h2 class="gb-section-title reveal-up" style="animation-delay:.06s">Operar GoBox al inicio cuesta muy poco</h2>
          <p class="gb-body-text reveal-up" style="animation-delay:.1s; margin-bottom:2rem;">
            La mayoría de los servicios que usa GoBox tienen un tramo gratuito generoso. Solo empiezas a pagar cuando creces, y aun así el costo se mantiene bajo.
          </p>

          <div class="gb-ops-table-wrap reveal-up" style="animation-delay:.14s">
            <table class="gb-ops-table">
              <thead>
                <tr>
                  <th>Servicio</th>
                  <th>Para qué</th>
                  <th>Costo al arrancar</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Hosting de la aplicación</strong></td>
                  <td>Donde vive el sistema</td>
                  <td class="gb-ops-free">Desde $0 <span>tramo gratuito inicial</span></td>
                </tr>
                <tr>
                  <td><strong>Base de datos</strong></td>
                  <td>Clientes, paquetes, membresías</td>
                  <td class="gb-ops-free">Gratis <span>incluido al inicio</span></td>
                </tr>
                <tr>
                  <td><strong>SSL y velocidad</strong></td>
                  <td>Seguridad y carga rápida (Cloudflare)</td>
                  <td class="gb-ops-free">Gratis</td>
                </tr>
                <tr>
                  <td><strong>Correos</strong></td>
                  <td>Notificaciones al cliente</td>
                  <td class="gb-ops-free">Gratis <span>hasta 3,000/mes</span></td>
                </tr>
                <tr>
                  <td><strong>Cobros en línea</strong></td>
                  <td>Procesa membresías (Stripe)</td>
                  <td>Sin costo fijo <span class="gb-ops-note">solo comisión por pago recibido*</span></td>
                </tr>
                <tr>
                  <td><strong>Dominio (.com)</strong></td>
                  <td>La dirección web</td>
                  <td>~$15 USD / año</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="gb-ops-highlight reveal-up" style="animation-delay:.18s">
            Estimado total al arrancar: <strong>menos de $35 USD al mes</strong>, buena parte dentro del tramo gratuito. Los servicios crecen contigo y solo pagas más cuando tu base de clientes también crece.
          </div>
          <p class="gb-ops-fine">
            *La comisión de Stripe es un porcentaje por transacción, no un costo fijo mensual. Todos estos servicios quedan como cuentas a nombre del cliente.
          </p>
        </div>
      </section>

      <!-- ── 8. DESPUÉS DE LA ENTREGA ───────────────────────────── -->
      <section class="gb-section">
        <div class="gb-container gb-container--narrow">
          <p class="gb-section-label reveal-up">Soporte</p>
          <h2 class="gb-section-title reveal-up" style="animation-delay:.06s">Después de la entrega</h2>
          <p class="gb-body-text reveal-up" style="animation-delay:.1s;">
            El soporte y los ajustes posteriores se atienden bajo solicitud, sin contratos obligatorios ni mensualidades forzadas.
          </p>
          <div class="gb-soporte-grid reveal-up" style="animation-delay:.14s">
            <div class="gb-soporte-card">
              <span class="gb-soporte-price">$800 MXN / hr</span>
              <span class="gb-soporte-label">Por hora</span>
              <span class="gb-soporte-desc">Ajustes, mejoras o consultas que toman tiempo variable.</span>
            </div>
            <div class="gb-soporte-card">
              <span class="gb-soporte-price">Desde $500 MXN</span>
              <span class="gb-soporte-label">Por ticket</span>
              <span class="gb-soporte-desc">Tareas puntuales con alcance claro: corrección, cambio de texto, ajuste de flujo.</span>
            </div>
          </div>
          <p class="gb-ops-fine reveal-up" style="animation-delay:.18s; margin-top:.75rem;">
            Precios orientativos + IVA. El costo exacto se confirma antes de iniciar cada solicitud.
          </p>
        </div>
      </section>

      <!-- ── 9. QUÉ NO INCLUYE ──────────────────────────────────── -->
      <section class="gb-section gb-section--alt">
        <div class="gb-container gb-container--narrow">
