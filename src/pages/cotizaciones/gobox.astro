---
import '~/styles/global.css';
import '~/components/cotizaciones/proposal.css';
import { ClientRouter } from 'astro:transitions';
import translations from '~/components/cotizaciones/gobox.i18n.json';

const validUntil = '31 de agosto de 2026';

const whatsappMsg = encodeURIComponent(
  '¡Hola Cleverum! Vi la propuesta de GoBox y me interesa avanzar.',
);
const whatsappUrl = `https://wa.me/5215541433545?text=${whatsappMsg}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>GoBox MVP — Propuesta de desarrollo · Cleverum</title>
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <ClientRouter />
  </head>

  <body class="gb-body">

    <!-- ── TOPBAR ──────────────────────────────────────────────── -->
    <header class="proposal-topbar">
      <div class="proposal-topbar-inner">
        <div class="proposal-topbar-brand">
          <img src="/logos/cleverum-logo.png" alt="Cleverum" class="proposal-topbar-logo" />
          <span class="proposal-topbar-name">Cleverum</span>
        </div>
        <div class="proposal-topbar-meta">
          <span class="proposal-badge gb-badge" data-i18n="topbar.badge">Propuesta GoBox</span>
          <span class="proposal-validity" data-i18n="topbar.validity">Válida hasta el {validUntil}</span>
          <div class="gb-lang-seg" role="group" aria-label="Idioma / Language">
            <button class="gb-lang-opt is-active" data-lang="es" aria-pressed="true">
              <svg class="gb-flag" viewBox="0 0 20 14" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <rect width="7" height="14" fill="#006847"/>
                <rect x="7" width="6" height="14" fill="#FFFFFF"/>
                <rect x="13" width="7" height="14" fill="#CE1126"/>
              </svg>
              ES
            </button>
            <button class="gb-lang-opt" data-lang="en" aria-pressed="false">
              <svg class="gb-flag" viewBox="0 0 20 14" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <rect width="20" height="14" fill="#B22234"/>
                <rect y="1" width="20" height="2" fill="#FFFFFF"/>
                <rect y="5" width="20" height="2" fill="#FFFFFF"/>
                <rect y="9" width="20" height="2" fill="#FFFFFF"/>
                <rect y="13" width="20" height="1" fill="#FFFFFF"/>
                <rect width="8" height="7" fill="#3C3B6E"/>
              </svg>
              EN
            </button>
          </div>
        </div>
      </div>
    </header>

    <main>

      <!-- ── 1. HERO ──────────────────────────────────────────── -->
      <section class="gb-hero">
        <svg class="gb-deco gb-deco--left" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 130 500">
          <polygon points="0,0 90,0 130,250 90,500 0,500" fill="#0D2540" opacity="0.10"/>
          <polygon points="0,0 55,0  95,250  55,500 0,500" fill="#0D2540" opacity="0.06"/>
          <polygon points="78,152 130,205 78,258" fill="#F07820" opacity="0.55"/>
        </svg>
        <svg class="gb-deco gb-deco--right" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 130 500">
          <polygon points="130,0 40,0 0,250 40,500 130,500" fill="#F07820" opacity="0.22"/>
          <polygon points="130,0 75,0 35,250 75,500 130,500" fill="#F07820" opacity="0.12"/>
          <polygon points="52,175 0,228 52,280" fill="#0D2540" opacity="0.12"/>
        </svg>
        <div class="gb-hero-content">
          <p class="gb-eyebrow reveal-up" data-i18n="hero.eyebrow">Propuesta de Desarrollo · Cleverum para GoBox</p>
          <img
            src="/cotizaciones/gobox/go-box-logo.png"
            alt="GoBox"
            class="gb-hero-logo reveal-up"
            style="animation-delay:.06s"
          />
          <p class="gb-hero-sub reveal-up" style="animation-delay:.12s" data-i18n="hero.sub">
            Tu casillero en Estados Unidos: membresías, dirección de recepción y servicio de pickup.
          </p>
          <div class="gb-price-pill reveal-up" style="animation-delay:.18s">
            <span class="gb-price-amount">$80,000 MXN</span>
          </div>
          <p class="gb-valid-until reveal-up" style="animation-delay:.22s" data-i18n="hero.validity">
            Propuesta válida hasta el {validUntil}
          </p>
          <button class="gb-btn-mockup reveal-up" id="mockup-open" style="animation-delay:.24s">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <span data-i18n="mockup.btn">Ver mockup del portal</span>
          </button>
          <a href="#diagrama" class="gb-hero-arrow reveal-up" aria-label="Ver la propuesta" style="animation-delay:.30s">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
          </a>
        </div>
      </section>

      <!-- ── DIAGRAMA MVP ───────────────────────────────────────── -->
      <section id="diagrama" class="gb-section gb-section--alt">
        <div class="gb-container gb-container--wide">
          <p class="gb-section-label reveal-up" data-i18n="diagram.label">Así funciona el MVP</p>
          <h2 class="gb-section-title reveal-up" style="animation-delay:.06s" data-i18n="diagram.title">
            Procesos digitales y manuales
          </h2>
          <p class="gb-body-text reveal-up" style="animation-delay:.1s; margin-bottom:2rem; max-width:68ch;" data-i18n="diagram.body">
            El sistema hace lo que puede automatizarse. Tu equipo hace lo que requiere presencia física.
            Así arrancas con la menor fricción y el mayor control.
          </p>

          <!-- Leyenda -->
          <div class="gb-legend reveal-up" style="animation-delay:.14s">
            <span class="gb-legend-item">
              <span class="gb-legend-dot gb-legend-dot--digital"></span>
              <span data-i18n="diagram.legend.system"><strong>Sistema</strong> — GoBox lo hace automáticamente</span>
            </span>
            <span class="gb-legend-item">
              <span class="gb-legend-dot gb-legend-dot--manual"></span>
              <span data-i18n="diagram.legend.manual"><strong>Manual</strong> — Tu equipo lo hace a mano</span>
            </span>
          </div>

          <!-- Diagrama de flujo -->
          <div class="gb-flow reveal-up" style="animation-delay:.18s">

            <!-- Columna 1: CLIENTE -->
            <div class="gb-flow-col">
              <div class="gb-flow-header gb-flow-header--navy">
                <span class="gb-flow-num" data-i18n="col1.num">01</span>
                <span class="gb-flow-title" data-i18n="col1.title">CLIENTE</span>
                <span class="gb-flow-sub" data-i18n="col1.sub">Portal del socio</span>
              </div>
              <ul class="gb-flow-steps">
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col1.step1">Registro y verificación de correo</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col1.step2">Suite USA asignada (dirección única)</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col1.step3">Ve el estado de sus paquetes desde su portal</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col1.step4">Paga su membresía en línea (Stripe)</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col1.step5">Solicita pickup urgente desde su portal</span>
                </li>
              </ul>
            </div>

            <div class="gb-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>

            <!-- Columna 2: BODEGA -->
            <div class="gb-flow-col">
              <div class="gb-flow-header gb-flow-header--orange">
                <span class="gb-flow-num" data-i18n="col2.num">02</span>
                <span class="gb-flow-title" data-i18n="col2.title">BODEGA</span>
                <span class="gb-flow-sub" data-i18n="col2.sub">Registro y operación</span>
              </div>
              <ul class="gb-flow-steps">
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                  <span data-i18n="col2.step1">Recibe el paquete físicamente en bodega</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                  <span data-i18n="col2.step2">Da de alta el paquete en el panel (tracking + datos)</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                  <span data-i18n="col2.step3">Actualiza el estado del paquete a mano</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col2.step4">Notifica al cliente por correo: paquete recibido</span>
                </li>
              </ul>
            </div>

            <div class="gb-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>

            <!-- Columna 3: MEMBRESÍAS -->
            <div class="gb-flow-col">
              <div class="gb-flow-header gb-flow-header--navy">
                <span class="gb-flow-num" data-i18n="col3.num">03</span>
                <span class="gb-flow-title" data-i18n="col3.title">MEMBRESÍAS</span>
                <span class="gb-flow-sub" data-i18n="col3.sub">Cobro y activación</span>
              </div>
              <ul class="gb-flow-steps">
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col3.step1">Cliente paga su membresía en línea (Stripe)</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col3.step2">Stripe cobra la renovación automáticamente cada periodo</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                  <span data-i18n="col3.step3">El staff activa al socio nuevo en el panel al confirmar su primer pago</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                  <span data-i18n="col3.step4">El staff da de baja al socio si deja de pagar</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col3.step5">El socio ve su membresía activa y su Suite USA</span>
                </li>
              </ul>
            </div>

            <div class="gb-flow-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>

            <!-- Columna 4: RETIRO -->
            <div class="gb-flow-col">
              <div class="gb-flow-header gb-flow-header--orange">
                <span class="gb-flow-num" data-i18n="col4.num">04</span>
                <span class="gb-flow-title" data-i18n="col4.title">RETIRO</span>
                <span class="gb-flow-sub" data-i18n="col4.sub">Pickup en bodega</span>
              </div>
              <ul class="gb-flow-steps">
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col4.step1">Cliente ve "listo para retiro" en su portal</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                  <span data-i18n="col4.step2">Acude a la bodega y verifica su identidad</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                  <span data-i18n="col4.step3">Staff entrega el paquete físicamente</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                  <span data-i18n="col4.step4">Staff marca como ENTREGADO en el panel</span>
                </li>
                <li class="gb-flow-step">
                  <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                  <span data-i18n="col4.step5">Correo de confirmación — ciclo cerrado</span>
                </li>
              </ul>
            </div>

          </div><!-- /gb-flow -->

          <!-- Pickup Urgente -->
          <div class="gb-urgente reveal-up" style="animation-delay:.20s">
            <div class="gb-urgente-header">
              <span class="gb-urgente-icon">⚡</span>
              <div>
                <span class="gb-urgente-label" data-i18n="urgente.tag">Servicio incluido en el MVP</span>
                <h3 class="gb-urgente-title" data-i18n="urgente.title">Pickup Urgente</h3>
              </div>
            </div>
            <p class="gb-urgente-desc" data-i18n="urgente.desc">
              El cliente solicita desde su portal que el staff pase a comprar o recoger un artículo
              en una tienda cercana. El pedido queda registrado en el sistema; el staff lo atiende
              manualmente y actualiza el estado.
            </p>
            <div class="gb-urgente-steps">
              <span class="gb-flow-step" style="gap:.5rem">
                <span class="gb-step-tag gb-step-tag--digital" data-i18n="badge.system">Sistema</span>
                <span data-i18n="urgente.step1">Cliente solicita y describe el artículo</span>
              </span>
              <span class="gb-urgente-sep" aria-hidden="true">→</span>
              <span class="gb-flow-step" style="gap:.5rem">
                <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                <span data-i18n="urgente.step2">Staff recoge el artículo en tienda</span>
              </span>
              <span class="gb-urgente-sep" aria-hidden="true">→</span>
              <span class="gb-flow-step" style="gap:.5rem">
                <span class="gb-step-tag gb-step-tag--manual" data-i18n="badge.manual">Manual</span>
                <span data-i18n="urgente.step3">Registra y atiende el servicio en el panel</span>
              </span>
            </div>
          </div>

          <!-- Panel Admin -->
          <div class="gb-flow-admin reveal-up" style="animation-delay:.22s">
            <div class="gb-flow-admin-label">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              <span data-i18n="admin.label">Panel de Administración — transversal a todo el proceso</span>
            </div>
            <p class="gb-flow-admin-desc" data-i18n="admin.desc">
              Tu equipo gestiona desde un solo panel: clientes activos, paquetes en bodega, membresías y solicitudes de pickup. Sin saltar entre herramientas.
            </p>
          </div>

          <!-- Nota Stripe -->
          <p class="gb-stripe-note reveal-up" style="animation-delay:.23s" data-i18n="stripe.note">
            Sobre los cobros: Stripe cobra la mensualidad automáticamente a cada socio, sin que tu equipo tenga que perseguir pagos. Lo único manual es activar a cada socio nuevo y dar de baja a quien deje de pagar — con un clic desde el panel. Cuando el volumen crezca, se puede automatizar esta sincronización en una fase posterior.
          </p>

          <!-- Tech highlights: Mobile-first + PWA -->
          <div class="gb-tech-grid reveal-up" style="animation-delay:.24s">
            <div class="gb-tech-card">
              <span class="gb-tech-icon">📱</span>
              <div>
                <h4 class="gb-tech-title" data-i18n="tech.mobile.title">Mobile-first</h4>
                <p class="gb-tech-desc" data-i18n="tech.mobile.desc">El portal se ve y funciona perfecto en cualquier celular desde el primer día. Diseño responsive garantizado.</p>
              </div>
            </div>
            <div class="gb-tech-card">
              <span class="gb-tech-icon">⚡</span>
              <div>
                <h4 class="gb-tech-title" data-i18n="tech.pwa.title">PWA-ready</h4>
                <p class="gb-tech-desc" data-i18n="tech.pwa.desc">El portal del cliente se construye con la base técnica lista (Capacitor) para convertirse en app instalable más adelante. En este MVP no se crea ni publica la app en las tiendas; eso es una fase posterior, y aplicaría solo al portal del socio (el panel de administración se seguiría usando desde el navegador).</p>
              </div>
            </div>
            <div class="gb-tech-card">
              <svg class="gb-tech-icon-svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              <div>
                <h4 class="gb-tech-title" data-i18n="tech.bilingual.title">Bilingüe ES / EN</h4>
                <p class="gb-tech-desc" data-i18n="tech.bilingual.desc">El portal del cliente está disponible en español e inglés; el socio cambia de idioma con un clic. (El panel de administración y los correos operan en español.)</p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ── 4. COMPARATIVA ──────────────────────────────────────── -->
      <section class="gb-section">
        <div class="gb-container">
          <p class="gb-section-label reveal-up" data-i18n="compare.label">Por qué a la medida</p>
          <h2 class="gb-section-title reveal-up" style="animation-delay:.06s" data-i18n="compare.title">GoBox vs. software genérico</h2>
          <p class="gb-body-text gb-container--narrow reveal-up" style="animation-delay:.1s; margin: 0 auto 2.5rem;" data-i18n="compare.body">
            Existe software empaquetado de package forwarding (MyUS, Stackry, Shipito, etc.), pero está diseñado para el mercado global en inglés, con modelos rígidos que no se adaptan a México. Puedes rentarlo, pero lo que obtienes es una caja que alguien más controla.
          </p>

          <div class="gb-compare-grid reveal-up" style="animation-delay:.14s">
            <div class="gb-compare-col gb-compare-col--generic">
              <div class="gb-compare-header">
                <span class="gb-compare-tag gb-compare-tag--neutral" data-i18n="compare.col1.tag">Software empaquetado</span>
                <p class="gb-compare-subhead" data-i18n="compare.col1.sub">licencia / renta mensual</p>
              </div>
              <ul class="gb-compare-list">
                <li class="gb-compare-item gb-compare-item--bad" data-i18n="compare.col1.item1">Licencia desde ~$1,700 USD (~$30,000 MXN) o renta mensual encima</li>
                <li class="gb-compare-item gb-compare-item--bad" data-i18n="compare.col1.item2">En inglés, pensado para el mercado global</li>
                <li class="gb-compare-item gb-compare-item--bad" data-i18n="compare.col1.item3">No factura CFDI de forma nativa</li>
                <li class="gb-compare-item gb-compare-item--bad" data-i18n="compare.col1.item4">Sin notificaciones por WhatsApp de forma nativa</li>
                <li class="gb-compare-item gb-compare-item--bad" data-i18n="compare.col1.item5">Modelo de cobro rígido, difícil de adaptar a tu operación</li>
                <li class="gb-compare-item gb-compare-item--bad" data-i18n="compare.col1.item6">Personalizarlo cuesta aparte y queda frágil ante actualizaciones</li>
                <li class="gb-compare-item gb-compare-item--bad" data-i18n="compare.col1.item7">Dependes de una empresa externa que puede subir precios o cerrar</li>
              </ul>
            </div>
            <div class="gb-compare-col gb-compare-col--custom">
              <div class="gb-compare-header">
                <span class="gb-compare-tag gb-compare-tag--accent" data-i18n="compare.col2.tag">GoBox a la medida</span>
                <p class="gb-compare-subhead" data-i18n="compare.col2.sub">tuyo, sin ataduras</p>
              </div>
              <ul class="gb-compare-list">
                <li class="gb-compare-item gb-compare-item--good" data-i18n="compare.col2.item1">100% tuyo, sin renta mensual de licencia</li>
                <li class="gb-compare-item gb-compare-item--good" data-i18n="compare.col2.item2">En español y pensado para tu operación en México</li>
                <li class="gb-compare-item gb-compare-item--good" data-i18n="compare.col2.item3">Preparado para crecer con CFDI, WhatsApp y envíos cuando lo necesites</li>
                <li class="gb-compare-item gb-compare-item--good" data-i18n="compare.col2.item4">Adaptado exactamente a tu modelo de membresías y servicios</li>
                <li class="gb-compare-item gb-compare-item--good" data-i18n="compare.col2.item5">Sin ataduras a ningún proveedor externo</li>
              </ul>
            </div>
          </div>

          <div class="gb-compare-honest reveal-up" style="animation-delay:.18s" data-i18n="compare.honest">
            "Si solo necesitas algo genérico y en inglés, el software empaquetado puede ser más barato.
            GoBox tiene sentido cuando quieres un sistema hecho para tu negocio, en tu idioma y que sea tuyo."
          </div>
        </div>
      </section>

      <!-- ── 5. SIGUIENTES FASES ─────────────────────────────────── -->
