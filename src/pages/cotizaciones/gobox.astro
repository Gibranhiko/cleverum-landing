  .gb-hero-logo { height: clamp(60px, 14vw, 110px); width: auto; object-fit: contain; }

  .gb-hero-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--gb-text-2);
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }

  .gb-price-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    background: var(--gb-orange-dim);
    border: 1.5px solid var(--gb-orange-bd);
    border-radius: 100px;
    padding: 0.6rem 1.5rem;
  }

  .gb-price-amount { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.03em; color: var(--gb-navy); }
  .gb-price-tax    { font-size: 0.9rem; color: var(--gb-text-3); font-weight: 500; }

  @keyframes gb-bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(6px); }
  }

  .gb-valid-until { font-size: 0.8rem; color: var(--gb-text-3); margin: 0; }

  .gb-hero-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px; height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--gb-orange-bd);
    color: var(--gb-orange);
    background: var(--gb-orange-dim);
    text-decoration: none;
    animation: gb-bob 2s ease-in-out infinite;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    margin-top: 0.25rem;
  }

  .gb-hero-arrow:hover {
    background: rgba(240,120,32,0.18);
    border-color: var(--gb-orange);
    transform: translateY(3px);
    animation: none;
  }

  /* ── Buttons ────────────────────────────────────────────────── */
  .gb-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    background: var(--gb-orange);
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px -4px rgba(240,120,32,0.5);
  }

  .gb-btn-primary:hover { opacity: 0.92; transform: translateY(-2px); box-shadow: 0 8px 28px -4px rgba(240,120,32,0.55); }
  .gb-btn-large { padding: 1.1rem 2.75rem; font-size: 1.05rem; }

  /* ── Layout ─────────────────────────────────────────────────── */
  .gb-section {
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.25rem, 4vw, 2.5rem);
    background: var(--gb-bg);
  }

  .gb-section--alt {
    background: var(--gb-bg-alt);
    border-top: 1px solid var(--gb-border);
    border-bottom: 1px solid var(--gb-border);
  }

  .gb-container        { max-width: 1040px; margin: 0 auto; }
  .gb-container--wide  { max-width: 1200px; margin: 0 auto; }
  .gb-container--narrow{ max-width: 720px;  margin: 0 auto; }

  .gb-section-label {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--gb-orange-txt);
    margin: 0 0 0.6rem; display: block;
  }

  .gb-section-title {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem); font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.1; color: var(--gb-text-1);
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .gb-lead      { font-size: 1.1rem; line-height: 1.75; color: var(--gb-text-2); margin: 0; }
  .gb-body-text { font-size: 1rem;   line-height: 1.75; color: var(--gb-text-2); margin: 0; }

  /* ── Diagrama ────────────────────────────────────────────────── */
  .gb-legend {
    display: flex; gap: 1.5rem; flex-wrap: wrap;
    margin-bottom: 2rem; padding: 0.75rem 1.1rem;
    background: #FFFFFF; border: 1px solid var(--gb-border);
    border-radius: 8px; width: fit-content;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }

  .gb-legend-item { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.82rem; color: var(--gb-text-2); }
  .gb-legend-item strong { color: var(--gb-text-1); }
  .gb-legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .gb-legend-dot--digital { background: var(--gb-green); }
  .gb-legend-dot--manual  { background: #b45309; }

  .gb-flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .gb-flow {
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      gap: 0; column-gap: 0.6rem; align-items: stretch;
    }
    .gb-flow .gb-legend     { grid-column: 1 / -1; }
    .gb-flow .gb-flow-admin { grid-column: 1 / -1; }
  }

  .gb-flow-arrow {
    display: none; align-items: center; justify-content: center;
    color: var(--gb-orange); opacity: 0.55; padding: 0; margin-top: 3.5rem;
  }
  @media (min-width: 900px) { .gb-flow-arrow { display: flex; } }

  .gb-flow-col {
    background: #FFFFFF; border: 1px solid var(--gb-border);
    border-radius: var(--gb-radius); overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: box-shadow 0.25s;
  }
  .gb-flow-col:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.10); }

  .gb-flow-header { padding: 0.9rem 1rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .gb-flow-header--navy   { background: #0D2540; }
  .gb-flow-header--orange { background: #E56B10; }
  .gb-flow-header--green  { background: #0D2540; }
  .gb-flow-header--teal   { background: #E56B10; }

  .gb-flow-num   { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; color: rgba(255,255,255,0.50); }
  .gb-flow-title { font-size: 0.82rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; line-height: 1.2; }
  .gb-flow-sub   { font-size: 0.7rem; color: rgba(255,255,255,0.65); }

  .gb-flow-steps { list-style: none; padding: 0.9rem; margin: 0; display: flex; flex-direction: column; gap: 0.65rem; flex: 1; background: #FFFFFF; }

  .gb-flow-step { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.8rem; line-height: 1.45; color: var(--gb-text-2); }

  .gb-step-tag { flex-shrink: 0; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 4px; padding: 0.12rem 0.4rem; margin-top: 0.1em; white-space: nowrap; }
  .gb-step-tag--digital { color: var(--gb-green); background: rgba(22,163,74,0.10); border: 1px solid rgba(22,163,74,0.22); }
  .gb-step-tag--manual  { color: #b45309; background: rgba(251,191,36,0.15); border: 1px solid rgba(251,191,36,0.35); }

  .gb-flow-admin {
    margin-top: 0.5rem; padding: 1rem 1.5rem;
    background: var(--gb-navy); border-radius: 12px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;
  }

  .gb-flow-admin-label {
    display: inline-flex; align-items: center; gap: 0.45rem;
    flex-shrink: 1; font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: #F07820; background: rgba(240,120,32,0.18);
    border: 1px solid rgba(240,120,32,0.35);
    border-radius: 100px; padding: 0.25rem 0.75rem;
  }

  .gb-flow-admin-desc { font-size: 0.85rem; color: rgba(255,255,255,0.75); margin: 0; line-height: 1.55; }

  .gb-stripe-note {
    margin-top: 0.75rem;
    padding: 0.9rem 1.25rem;
    background: rgba(240,120,32,0.05);
    border-left: 3px solid var(--gb-orange-bd);
    border-radius: 0 8px 8px 0;
    font-size: 0.82rem;
    color: var(--gb-text-2);
    line-height: 1.65;
  }

  /* ── Tech highlights ─────────────────────────────────────────── */
  .gb-tech-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 520px) { .gb-tech-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .gb-tech-grid { grid-template-columns: repeat(3, 1fr); } }

  .gb-tech-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    background: var(--gb-bg-card);
    border: 1px solid var(--gb-border);
    border-radius: var(--gb-radius);
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  }

  .gb-tech-icon      { font-size: 1.5rem; line-height: 1; flex-shrink: 0; margin-top: 0.1rem; }
  .gb-tech-icon-svg  { flex-shrink: 0; margin-top: 0.1rem; color: var(--gb-navy); opacity: 0.7; }
  .gb-tech-title { font-size: 0.95rem; font-weight: 700; color: var(--gb-text-1); margin: 0 0 0.25rem; }
  .gb-tech-desc  { font-size: 0.82rem; color: var(--gb-text-2); margin: 0; line-height: 1.55; }

  /* ── Urgente ────────────────────────────────────────────────── */
  .gb-urgente { margin-top: 1.25rem; padding: 1.25rem 1.5rem; background: rgba(240,120,32,0.06); border: 1.5px solid rgba(240,120,32,0.22); border-radius: var(--gb-radius); }
  .gb-urgente-header  { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
  .gb-urgente-icon    { font-size: 1.5rem; line-height: 1; flex-shrink: 0; }
  .gb-urgente-label   { display: block; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gb-orange-txt); margin-bottom: 0.15rem; }
  .gb-urgente-title   { font-size: 1.05rem; font-weight: 800; color: var(--gb-navy); margin: 0; letter-spacing: -0.01em; }
  .gb-urgente-desc    { font-size: 0.875rem; color: var(--gb-text-2); line-height: 1.6; margin: 0 0 1rem; max-width: 72ch; }
  .gb-urgente-steps   { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .gb-urgente-sep     { color: var(--gb-orange); font-size: 1rem; font-weight: 700; }

  /* ── Soporte ────────────────────────────────────────────────── */
  .gb-soporte-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1.25rem; }
  @media (min-width: 520px) { .gb-soporte-grid { grid-template-columns: repeat(2, 1fr); } }
  .gb-soporte-card { display: flex; flex-direction: column; gap: 0.25rem; padding: 1.25rem 1.4rem; background: var(--gb-bg-card); border: 1px solid var(--gb-border); border-radius: var(--gb-radius); box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
  .gb-soporte-price { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.03em; color: var(--gb-navy); line-height: 1.1; }
  .gb-soporte-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gb-text-3); margin-bottom: 0.4rem; }
  .gb-soporte-desc  { font-size: 0.82rem; color: var(--gb-text-2); line-height: 1.5; }

  /* ── Comparativa ────────────────────────────────────────────── */
  .gb-compare-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin-bottom: 2rem; }
  @media (min-width: 700px) { .gb-compare-grid { grid-template-columns: repeat(2, 1fr); } }
  .gb-compare-col { border-radius: var(--gb-radius); border: 1px solid var(--gb-border); overflow: hidden; background: #FFFFFF; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
  .gb-compare-col--custom { border-color: rgba(240,120,32,0.35); box-shadow: 0 0 0 1px rgba(240,120,32,0.12), 0 8px 24px -8px rgba(240,120,32,0.12); }
  .gb-compare-header { padding: 1rem 1.4rem; background: var(--gb-bg-alt); border-bottom: 1px solid var(--gb-border); }
  .gb-compare-col--custom .gb-compare-header { background: rgba(240,120,32,0.06); border-bottom-color: rgba(240,120,32,0.18); }
  .gb-compare-tag { display: inline-block; padding: 0.2rem 0.7rem; border-radius: 100px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.3rem; }
  .gb-compare-tag--neutral { color: var(--gb-text-3); background: rgba(0,0,0,0.05); border: 1px solid var(--gb-border); }
  .gb-compare-tag--accent  { color: var(--gb-orange-txt); background: var(--gb-orange-dim); border: 1px solid var(--gb-orange-bd); }
  .gb-compare-subhead { font-size: 0.8rem; color: var(--gb-text-3); margin: 0; }
  .gb-compare-list { list-style: none; padding: 1rem 1.4rem; margin: 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .gb-compare-item { font-size: 0.875rem; line-height: 1.5; padding-left: 1.25rem; position: relative; color: var(--gb-text-2); }
  .gb-compare-item::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 7px; height: 7px; border-radius: 50%; }
  .gb-compare-item--bad::before  { background: #dc2626; opacity: 0.7; }
  .gb-compare-item--good         { color: var(--gb-text-1); }
  .gb-compare-item--good::before { background: var(--gb-green); }
  .gb-compare-honest { padding: 1.1rem 1.5rem; border-left: 3px solid var(--gb-border-md); font-size: 0.9rem; font-style: italic; color: var(--gb-text-2); line-height: 1.65; background: var(--gb-bg-alt); border-radius: 0 8px 8px 0; }

  /* ── Fases ───────────────────────────────────────────────────── */
  .gb-phases { display: flex; flex-direction: column; gap: 1rem; }
  .gb-phase { display: flex; align-items: flex-start; gap: 1.25rem; padding: 1.25rem 1.5rem; background: var(--gb-bg-card); border: 1px solid var(--gb-border); border-radius: var(--gb-radius); box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
  .gb-phase-num { flex-shrink: 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gb-orange-txt); background: var(--gb-orange-dim); border: 1px solid var(--gb-orange-bd); border-radius: 100px; padding: 0.25rem 0.75rem; margin-top: 0.15rem; white-space: nowrap; }
  .gb-phase-title { font-size: 1rem; font-weight: 700; color: var(--gb-text-1); margin: 0 0 0.25rem; }
  .gb-phase-desc  { font-size: 0.875rem; color: var(--gb-text-2); margin: 0; }

  /* ── Inversión ───────────────────────────────────────────────── */
  .gb-investment-hero { text-align: center; margin-bottom: 2.5rem; }
  .gb-investment-amount { font-size: clamp(2.5rem, 7vw, 4rem); font-weight: 800; letter-spacing: -0.04em; color: var(--gb-navy); line-height: 1; }
  .gb-investment-amount small { font-size: 0.45em; font-weight: 500; color: var(--gb-text-3); vertical-align: super; }
  .gb-payment-grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 2rem; }
  .gb-payment-step { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 1.25rem 1.75rem; background: var(--gb-bg-card); border: 1px solid var(--gb-border); border-radius: var(--gb-radius); text-align: center; min-width: 140px; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
  .gb-payment-pct     { font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; color: var(--gb-navy); line-height: 1; }
  .gb-payment-label   { font-size: 0.8rem; font-weight: 600; color: var(--gb-text-2); }
  .gb-payment-sub     { font-size: 0.78rem; color: var(--gb-text-3); }
  .gb-payment-divider { font-size: 1.25rem; color: var(--gb-text-3); }
  @media (max-width: 520px) {
    .gb-payment-divider { display: none; }
    .gb-payment-grid    { flex-direction: column; align-items: stretch; }
    .gb-payment-step    { min-width: unset; }
  }
  .gb-pay-note {
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding: 0.85rem 1.25rem;
    background: var(--gb-bg-alt);
    border: 1px solid var(--gb-border);
    border-radius: 8px;
    font-size: 0.82rem;
    color: var(--gb-text-2);
    line-height: 1.65;
  }

  .gb-timeline-pill { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; justify-content: center; padding: 1rem 1.5rem; background: var(--gb-bg-card); border: 1px solid var(--gb-border); border-radius: 10px; font-size: 0.9rem; color: var(--gb-text-2); text-align: center; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
  .gb-timeline-pill strong { color: var(--gb-text-1); }
  .gb-timeline-note { display: block; width: 100%; font-size: 0.8rem; color: var(--gb-text-3); }

  /* ── Tabla operación ─────────────────────────────────────────── */
  .gb-ops-table-wrap { overflow-x: auto; border-radius: var(--gb-radius); border: 1px solid var(--gb-border); margin-bottom: 1.5rem; background: #FFFFFF; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
  .gb-ops-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .gb-ops-table thead tr { background: var(--gb-bg-alt); }
  .gb-ops-table th { padding: 0.85rem 1.1rem; text-align: left; font-weight: 700; color: var(--gb-text-1); font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; border-bottom: 1px solid var(--gb-border); white-space: nowrap; }
  .gb-ops-table td { padding: 0.8rem 1.1rem; border-bottom: 1px solid var(--gb-border); color: var(--gb-text-2); vertical-align: top; }
  .gb-ops-table tr:last-child td { border-bottom: none; }
  .gb-ops-table strong { color: var(--gb-text-1); font-weight: 600; }
  .gb-ops-free { color: var(--gb-green) !important; font-weight: 600; }
  .gb-ops-free span, .gb-ops-note { display: block; font-size: 0.78rem; font-weight: 400; color: var(--gb-text-3); }
  .gb-ops-highlight { padding: 1.1rem 1.5rem; background: rgba(22,163,74,0.06); border: 1px solid rgba(22,163,74,0.18); border-radius: 10px; font-size: 0.95rem; color: var(--gb-text-2); line-height: 1.65; margin-bottom: 0.75rem; }
  .gb-ops-highlight strong { color: var(--gb-green); }
  .gb-ops-fine { font-size: 0.78rem; color: var(--gb-text-3); line-height: 1.6; margin: 0; }

  /* ── No incluye ──────────────────────────────────────────────── */
  .gb-not-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .gb-not-list li { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem 1.25rem; background: var(--gb-bg-card); border: 1px solid var(--gb-border); border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
  .gb-not-arrow  { color: var(--gb-orange); font-weight: 700; font-size: 1rem; flex-shrink: 0; margin-top: 0.1em; }
  .gb-not-list strong { display: block; font-size: 0.95rem; font-weight: 700; color: var(--gb-text-1); margin-bottom: 0.2rem; }
  .gb-not-list span   { font-size: 0.85rem; color: var(--gb-text-2); }
  .gb-callout { margin-top: 1.75rem; padding: 1.1rem 1.5rem; border-left: 3px solid var(--gb-orange); background: rgba(240,120,32,0.06); border-radius: 0 10px 10px 0; font-size: 0.95rem; font-style: italic; color: var(--gb-text-2); line-height: 1.6; }

  /* ── Steps / CTA ─────────────────────────────────────────────── */
  .gb-cta-section { background: var(--gb-bg-alt) !important; }
  .gb-steps { list-style: none; padding: 0; margin: 0 0 3rem; display: flex; flex-direction: column; gap: 0.85rem; }
  .gb-step { display: flex; align-items: flex-start; gap: 1.25rem; padding: 1.25rem 1.5rem; background: var(--gb-bg-card); border: 1px solid var(--gb-border); border-radius: var(--gb-radius); box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
  .gb-step-num { flex-shrink: 0; width: 2.2rem; height: 2.2rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--gb-orange); font-size: 0.78rem; font-weight: 800; color: #ffffff; }
  .gb-step-title { font-size: 1rem; font-weight: 700; color: var(--gb-text-1); margin: 0 0 0.25rem; }
  .gb-step-desc  { font-size: 0.875rem; color: var(--gb-text-2); margin: 0; line-height: 1.55; }
  .gb-cta-block { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; text-align: center; }
  .gb-cta-tagline { font-size: 1.1rem; font-weight: 600; color: var(--gb-text-1); margin: 0; max-width: 42ch; line-height: 1.4; }

  /* ── Footer ─────────────────────────────────────────────────── */
  .gb-footer { padding: 2.5rem clamp(1.25rem, 4vw, 2.5rem); background: var(--gb-navy); border-top: none; }
  .gb-footer-inner { max-width: 1040px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .gb-footer-brand { display: flex; align-items: center; gap: 0.75rem; }
  .gb-footer-logo    { height: 24px; width: auto; filter: brightness(0) invert(1); }
  .gb-footer-name    { display: block; font-size: 0.95rem; font-weight: 700; color: #FFFFFF; }
  .gb-footer-tagline { display: block; font-size: 0.75rem; color: rgba(255,255,255,0.50); }
  .gb-footer-copy    { font-size: 0.78rem; color: rgba(255,255,255,0.40); margin: 0; }

  /* ── Reduced motion ──────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .gb-btn-primary, .gb-flow-col, .gb-hero-arrow { transition: none; }
    .gb-btn-primary:hover, .gb-hero-arrow         { transform: none; }
    .gb-hero-arrow                                { animation: none; }
  }

  /* ── Mobile (<600px) ─────────────────────────────────────────── */
  @media (max-width: 599px) {
