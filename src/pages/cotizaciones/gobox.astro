    <!-- Scroll reveal (TypeScript, processed by Vite) -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08 },
      );
      document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
    </script>

    <!-- i18n segmented selector (inline via define:vars — plain JS) -->
    <script define:vars={{ translations }}>
      var opts = document.querySelectorAll('.gb-lang-opt');
      var activeLang = localStorage.getItem('gb-lang') || 'es';

      function applyLang(lang) {
        activeLang = lang;
        localStorage.setItem('gb-lang', lang);
        opts.forEach(function(btn) {
          var isActive = btn.getAttribute('data-lang') === lang;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        var dict = translations[lang];
        document.querySelectorAll('[data-i18n]').forEach(function(el) {
          var key = el.getAttribute('data-i18n');
          if (dict[key] !== undefined) el.innerHTML = dict[key];
        });
      }

      opts.forEach(function(btn) {
        btn.addEventListener('click', function() { applyLang(btn.getAttribute('data-lang')); });
      });

      if (activeLang === 'en') applyLang('en');
    </script>

