  *, *::before, *::after { box-sizing: border-box; }

  /* ── Topbar: tema claro ─────────────────────────────────────── */
  .proposal-topbar {
    background: #FFFFFF !important;
    border-bottom: 1px solid var(--gb-border) !important;
