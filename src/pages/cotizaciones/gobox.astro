    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08 },
      );
      document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
    </script>

