    -webkit-backdrop-filter: none !important;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }

  .proposal-topbar-name { color: var(--gb-navy) !important; }
  .proposal-validity    { color: var(--gb-text-3) !important; }

  .gb-badge {
    color: var(--gb-orange-txt) !important;
    background: var(--gb-orange-dim) !important;
    border-color: var(--gb-orange-bd) !important;
  }

  /* ── Hero ───────────────────────────────────────────────────── */
  .gb-hero {
    position: relative;
    padding: clamp(5rem, 12vw, 9rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3rem, 8vw, 6rem);
    text-align: center;
    overflow: hidden;
    background: linear-gradient(180deg, #EEF3FA 0%, #FFFFFF 100%);
  }

  /* Decoradores SVG */
  .gb-deco {
    position: absolute;
    top: 0;
    bottom: 0;
    height: 100%;
    width: auto;
    pointer-events: none;
    z-index: 0;
  }

  .gb-deco--left  { left: 0; }
  .gb-deco--right { right: 0; }

  @media (max-width: 900px) { .gb-deco { display: none; } }

  .gb-hero-content {
    max-width: 680px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .gb-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gb-orange-txt);
    margin: 0;
  }

  .gb-hero-logo {
    height: clamp(60px, 14vw, 110px);
    width: auto;
    object-fit: contain;
  }

  .gb-hero-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--gb-text-2);
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }

  .gb-price-pill {
    display: inline-flex;
