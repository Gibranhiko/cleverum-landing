    --gb-orange-bd:  rgba(240,120,32,0.28);
    --gb-bg:         #FFFFFF;
    --gb-bg-alt:     #F4F7FA;
    --gb-bg-card:    #FFFFFF;
    --gb-border:     #E2E8F0;
    --gb-border-md:  #CBD5E1;
    --gb-text-1:     #0D2540;   /* navy puro — 18:1 sobre blanco */
