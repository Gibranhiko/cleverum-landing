---
import '~/styles/global.css';
import '~/components/cotizaciones/proposal.css';
import { ClientRouter } from 'astro:transitions';

const client = {
  name: 'Raúl Cruz',
  company: 'Pisel Services',
  slug: 'pisel',
  logo: '/cotizaciones/pisel/pisel-logo.png',
  branding: '/cotizaciones/pisel/branding-pisel.png',
  color: '#1B4F72',
  colorLight: '#2E86C1',
};

const validUntil = '31 de julio de 2026';

const whatsappMsg = encodeURIComponent(
  `¡Hola Cleverum! Soy ${client.name} de ${client.company}. Vi la propuesta y me interesa arrancar con el Módulo 1 — Sitio Web Industrial.`,
);
const whatsappUrl = `https://wa.me/5215541433545?text=${whatsappMsg}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Propuesta Pisel · Cleverum</title>
    <meta name="description" content="Propuesta de modernización digital para Pisel Services." />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <ClientRouter />
  </head>

  <body class="proposal-body">

    <!-- ── TOP BAR ────────────────────────────────────────── -->
    <header class="proposal-topbar">
      <div class="proposal-topbar-inner">
        <div class="proposal-topbar-brand">
          <img src="/logos/cleverum-logo.png" alt="" class="proposal-topbar-logo" aria-hidden="true" />
          <span class="proposal-topbar-name">Cleverum</span>
        </div>
        <div class="proposal-topbar-meta">
          <span class="proposal-badge">Propuesta personalizada</span>
          <span class="proposal-validity">Válida hasta {validUntil}</span>
        </div>
      </div>
    </header>

    <main>

      <!-- ── HERO ──────────────────────────────────────────── -->
      <section class="proposal-hero">
        <div class="proposal-container">
          <div class="proposal-hero-client reveal-up">
            <img src={client.logo} alt={`${client.company} logo`} class="proposal-client-logo" />
          </div>
          <div class="proposal-hero-content reveal-up" style="animation-delay:.12s">
            <p class="proposal-label">Con atención para <strong>{client.name}</strong></p>
            <h1 class="proposal-hero-title">Propuesta de<br /><span class="proposal-hero-accent">Modernización Digital</span></h1>
            <p class="proposal-hero-sub">Convertimos tu sitio en una máquina que genera y organiza cotizaciones — sin depender del teléfono.</p>
          </div>
          <div class="proposal-hero-cta reveal-up" style="animation-delay:.22s">
            <a href={whatsappUrl} target="_blank" rel="noopener" class="proposal-btn-primary">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
              Quiero arrancar
            </a>
            <p class="proposal-hero-note">Te respondemos en menos de 2 horas</p>
          </div>
        </div>
        <div class="proposal-hero-scroll" aria-hidden="true">
          <span class="proposal-scroll-line"></span>
          <span class="proposal-scroll-text">Desliza para ver la propuesta</span>
        </div>
      </section>

      <!-- ── EL PROBLEMA ───────────────────────────────────── -->
      <section class="proposal-section">
        <div class="proposal-container">
          <div class="proposal-problem reveal-up">
            <p class="proposal-problem-eyebrow">El diagnóstico</p>
            <blockquote class="proposal-problem-quote">
              Tu empresa tiene un sitio web pero <strong>no les genera clientes.</strong>
            </blockquote>
            <p class="proposal-problem-body">
              Tu sitio actual es una tarjeta de presentación online, no una herramienta de ventas. Esta propuesta resuelve exactamente eso.
            </p>
          </div>
        </div>
      </section>

      <!-- ── CÓMO FUNCIONA ─────────────────────────────────── -->
      <section class="proposal-section proposal-section-flow">
        <div class="proposal-container">
          <h2 class="proposal-section-title reveal-up">Cómo funciona</h2>
          <div class="proposal-flow">
            {[
              { n: '01', label: 'Nuevo sitio web', sub: 'Módulo 1', active: true },
              { n: '02', label: 'El cliente cotiza online', sub: 'Módulos 1+2', active: false },
              { n: '03', label: 'Tu equipo recibe aviso', sub: 'Módulo 2', active: false },
              { n: '04', label: 'Cotización fuera en 24h', sub: 'Todo activo', active: false },
            ].map((step, i) => (
              <div class={`proposal-flow-step${step.active ? ' is-active' : ''} reveal-up`} style={`animation-delay:${i * 0.08}s`}>
                <div class="proposal-flow-num">{step.n}</div>
                <div class="proposal-flow-arrow" aria-hidden="true">→</div>
                <p class="proposal-flow-label">{step.label}</p>
                <p class="proposal-flow-sub">{step.sub}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ── MÓDULOS ────────────────────────────────────────── -->
      <section class="proposal-section">
        <div class="proposal-container">
          <h2 class="proposal-section-title reveal-up">Lo que incluye tu propuesta</h2>

          <!-- Módulo 1 — seleccionado -->
          <div class="proposal-module is-selected reveal-up">
            <div class="proposal-module-header">
              <div class="proposal-module-num">01</div>
              <div class="proposal-module-info">
                <p class="proposal-module-tag">Incluido en tu propuesta</p>
                <h3 class="proposal-module-title">Sitio Web Industrial</h3>
                <p class="proposal-module-sub">Tu presencia digital que trabaja para ti</p>
              </div>
              <div class="proposal-module-price">
                <span class="proposal-price-amount">$14,900</span>
                <span class="proposal-price-currency">MXN</span>
                <span class="proposal-price-type">pago único</span>
              </div>
            </div>
            <ul class="proposal-module-list">
              {[
                'Rediseño completo — moderno, industrial, profesional',
                'Optimizado para celular (70% de tus visitas llegan desde móvil)',
                'Página de cotización con formulario: servicio, material, cantidad y subida de planos',
                'Botones de acción visibles en cada sección del sitio',
                'Velocidad de carga optimizada (Google penaliza sitios lentos)',
                'Píxel de seguimiento: sabes cuántas personas visitan y cuántas piden cotización',
                'SEO técnico básico para aparecer en Google',
              ].map((item) => (
                <li class="proposal-module-item">
                  <span class="proposal-check" aria-hidden="true">✦</span>
                  {item}
                </li>
              ))}
            </ul>
            <p class="proposal-module-note">
              <strong>Entrega:</strong> 3 a 4 semanas · No incluye hosting ($800 MXN/año) ni dominio ($300 MXN/año)
            </p>
          </div>

          <!-- Módulo opcional — Rebranding -->
          <div class="proposal-module is-optional reveal-up" style="animation-delay:.1s">
            <div class="proposal-module-header">
              <div class="proposal-module-num proposal-module-num-opt">opt</div>
              <div class="proposal-module-info">
                <p class="proposal-module-tag proposal-module-tag-opt">Opcional — puedes agregarlo</p>
                <h3 class="proposal-module-title">Rebranding de Logotipo</h3>
                <p class="proposal-module-sub">Identidad visual que refleja quién eres hoy</p>
              </div>
              <div class="proposal-module-price">
                <span class="proposal-price-amount">$3,500</span>
                <span class="proposal-price-currency">MXN</span>
                <span class="proposal-price-type">pago único</span>
              </div>
            </div>

            <!-- Branding image -->
            <div class="proposal-branding-preview">
              <img
                src={client.branding}
                alt="Sistema de identidad visual Pisel"
                class="proposal-branding-img"
                loading="lazy"
              />
            </div>

            <ul class="proposal-module-list">
              {[
                'Rediseño del logotipo actual (3 propuestas, 2 rondas de ajustes)',
                'Archivos en todos los formatos: .AI, .EPS, .PNG, .SVG — fondo blanco y transparente',
                'Paleta de colores y tipografía definidas',
                'Mini guía de uso: cómo y dónde aplicar la nueva identidad',
              ].map((item) => (
                <li class="proposal-module-item">
                  <span class="proposal-check proposal-check-opt" aria-hidden="true">✦</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- ── INVERSIÓN ──────────────────────────────────────── -->
      <section class="proposal-section proposal-section-dark">
        <div class="proposal-container">
          <h2 class="proposal-section-title reveal-up">Tu inversión</h2>

          <div class="proposal-invest-cards reveal-up">
            <div class="proposal-invest-card is-highlight">
              <p class="proposal-invest-label">Solo Sitio Web</p>
              <p class="proposal-invest-price" data-count="14900">$14,900 <span>MXN</span></p>
              <p class="proposal-invest-desc">pago único · lo que acordamos hoy</p>
            </div>
            <div class="proposal-invest-card">
              <p class="proposal-invest-label">Sitio + Rebranding</p>
              <p class="proposal-invest-price">$18,400 <span>MXN</span></p>
              <p class="proposal-invest-desc">pago único · si agregas el logotipo</p>
            </div>
          </div>

          <div class="proposal-invest-note reveal-up" style="animation-delay:.1s">
            <p>Sin contratos de permanencia. Puedes iniciar con un módulo y agregar los demás cuando lo necesites. <strong>Propuesta válida 30 días.</strong></p>
          </div>
        </div>
      </section>

      <!-- ── SIGUIENTES PASOS ───────────────────────────────── -->
      <section class="proposal-section">
        <div class="proposal-container">
          <h2 class="proposal-section-title reveal-up">Siguientes pasos</h2>
          <ol class="proposal-steps">
            {[
              { n: '1', text: 'Confirmas que quieres arrancar — un mensaje por WhatsApp es suficiente.' },
              { n: '2', text: 'Acordamos fecha de inicio — normalmente la semana siguiente.' },
              { n: '3', text: 'Nos compartes acceso a tu sitio actual para ver con qué partimos.' },
              { n: '4', text: 'Entrega del Módulo 1 en 3 a 4 semanas. Sin sorpresas.' },
            ].map((step, i) => (
              <li class="proposal-step reveal-up" style={`animation-delay:${i * 0.08}s`}>
                <div class="proposal-step-num">{step.n}</div>
                <p class="proposal-step-text">{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ── CTA FINAL ──────────────────────────────────────── -->
      <section class="proposal-section proposal-section-cta">
        <div class="proposal-container">
          <div class="proposal-cta-box reveal-up">
            <div class="proposal-cta-glow" aria-hidden="true"></div>
            <img src={client.logo} alt={client.company} class="proposal-cta-logo" />
            <h2 class="proposal-cta-title">¿Arrancamos, {client.name.split(' ')[0]}?</h2>
            <p class="proposal-cta-body">Un mensaje y lo tenemos listo para la próxima semana.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener" class="proposal-btn-primary proposal-btn-lg">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
              Quiero arrancar con el Módulo 1
            </a>
            <p class="proposal-cta-fine">
              O escríbenos a
              <a href="mailto:gibran.villarreal@cleverum.org" class="proposal-cta-email">gibran.villarreal@cleverum.org</a>
            </p>
          </div>
        </div>
      </section>

    </main>

    <!-- ── FOOTER ─────────────────────────────────────────── -->
    <footer class="proposal-footer">
      <div class="proposal-container">
        <div class="proposal-footer-brand">
          <img src="/logos/cleverum-logo.png" alt="" class="proposal-footer-logo" aria-hidden="true" />
          <span class="proposal-footer-name">Cleverum</span>
        </div>
        <p class="proposal-footer-copy">cleverum.org · gibran.villarreal@cleverum.org · +52 55 4143 3545</p>
        <p class="proposal-footer-legal">Propuesta confidencial preparada exclusivamente para {client.company}. Válida hasta {validUntil}.</p>
      </div>
    </footer>

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
